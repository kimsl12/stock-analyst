# Vercel deploy 시 monorepo root에서 보낼 zip에서 제외할 항목들
# (knowledge-base/, reports/, scripts/는 vercel 빌드에서 web/scripts/build_*.mjs가 읽어야 하므로 포함 필수)

# Git
.git
.github

# 거대 캐시·생성물
web/node_modules
web/dist
web/.astro
web/.vercel

# Python venv·캐시
.venv
**/__pycache__
*.pyc

# IDE/OS
.DS_Store
._*
.idea
.vscode

# 일회성·임시
.tmp
산출물/
analysis/
.claude/

# 대용량 KB-DB는 빌드에 직접 필요하지 않음 (성과리뷰 명령은 빌드 외부)
knowledge-db
