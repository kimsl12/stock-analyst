# 종목분석 에이전트 — 환경변수 템플릿 (v3.22 P1-22)
#
# 사용법:
#   1. 이 파일을 .env.local 로 복사 (cp .env.example .env.local)
#   2. 각 값 채우기 (실제 비밀키)
#   3. .env.local 은 .gitignore 적용됨 (커밋 금지)
#
# 검증:
#   bash scripts/deploy_cloudflare.sh  # 자동 source 후 토큰 확인 메시지

# ── Cloudflare Pages (미러 배포) ──────────────────────────
# 발급: https://dash.cloudflare.com/profile/api-tokens
# 필요 권한: Account → Cloudflare Pages:Edit
# 미설정 시 wrangler OAuth 브라우저 로그인 폴백 (자동화 불가)
CLOUDFLARE_API_TOKEN=

# ── Supabase (jungwon-warehouse + 종목분석 공유) ──────────
# 출처: https://supabase.com/dashboard/project/{project-id}/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── FRED (거시 경제 지표) ─────────────────────────────────
# 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ── (선택) 빌드 패스워드 ──────────────────────────────────
# web/scripts/set_password.mjs 가 BUILD_NEW_PASSWORD 사용
BUILD_NEW_PASSWORD=
