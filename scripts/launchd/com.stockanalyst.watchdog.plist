<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  종목분석 에이전트 — 자동화 watchdog + 포트폴리오 감시 launchd 스케줄

  - 매일 KST 06:40 (미국장 마감 후 — 손절/목표가 점검) + 10:30 (오전 — daily_pick 신선도 점검)
  - 출력: ~/Library/Logs/stockanalyst/watchdog.log
    (외장 SSD 경로 StandardOutPath 는 launchd 가 열지 못해 spawn 실패 EX_CONFIG=78 — 2026-06-11 확정)

  설치:
    cp "scripts/launchd/com.stockanalyst.watchdog.plist" ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.stockanalyst.watchdog.plist

  즉시 테스트:
    launchctl start com.stockanalyst.watchdog

  제거:
    launchctl unload ~/Library/LaunchAgents/com.stockanalyst.watchdog.plist
    rm ~/Library/LaunchAgents/com.stockanalyst.watchdog.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockanalyst.watchdog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Volumes/외장SSD/클로드 AI 폴더/작업폴더/종목분석 에이전트/scripts/automation_watchdog.sh</string>
    </array>

    <!-- 매일 KST 06:40 + 10:30 -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>6</integer>
            <key>Minute</key>
            <integer>40</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>10</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/kimsl12/.nvm/versions/node/v25.9.0/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/kimsl12</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Volumes/외장SSD/클로드 AI 폴더/작업폴더/종목분석 에이전트</string>

    <key>StandardOutPath</key>
    <string>/Users/kimsl12/Library/Logs/stockanalyst/watchdog.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/kimsl12/Library/Logs/stockanalyst/watchdog.log</string>
</dict>
</plist>
