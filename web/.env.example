# ===========================================================
# 종목분석 에이전트 — 웹 환경변수 예시 (PLAN.md §9.2, §14.2)
#
# 사용법:
#   cp .env.example .env.local
#   # .env.local에 실제 값 입력 (절대 commit 금지)
#
# Vercel 배포 시: Vercel 대시보드 → Settings → Environment Variables
#   에 동일하게 등록 (PUBLIC_* 만 클라이언트 노출, 나머지는 서버 전용)
# ===========================================================

# Supabase Project URL
# Dashboard → Project Settings → API → Project URL
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Supabase Anonymous Key (anon, public)
# Dashboard → Project Settings → API → Project API keys → anon public
# 클라이언트(브라우저)에서 사용 — RLS로 보호됨
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.anon

# Supabase Service Role Key (★ 매우 민감 — 절대 클라이언트 노출 금지)
# Dashboard → Project Settings → API → Project API keys → service_role
# RLS 우회. sync 스크립트(scripts/sync_portfolio_to_supabase.py)에서만 사용.
# Git commit 절대 금지 (PLAN.md §16-3).
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example.service

# 화이트리스트 이메일 (PLAN.md §6.3, §9.3)
# 이 이메일 외에는 Magic Link 인증 거부
# SSG 환경: 클라이언트 사이드 가드를 위해 PUBLIC_ 접두사 필수.
# (이메일 자체는 빌드 산출물에 임베드 — 실제 보안은 Supabase 콜백 거부 + RLS)
PUBLIC_ALLOWED_EMAIL=jungwon9402@gmail.com

# FRED API Key (St. Louis Fed)
# 발급: https://fredaccount.stlouisfed.org/login/secure/  (무료, 2분)
# 용도: scripts/fetch_fred.mjs (prebuild 단계) — 매크로 80만+ 시계열
# 미설정 시 위젯이 등록 가이드 표시. 빌드는 정상 진행.
FRED_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
