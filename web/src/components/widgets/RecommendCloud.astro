---
import kb from '../../data/kb.json';
import names from '../../data/ticker_names_kr.json';

type Rec = { text: string; count: number };
const recs = kb.recommendations as Rec[];

// 모든 카테고리(stocks/etfs/kr/crypto)를 단일 lookup으로 평탄화
const lookup: Record<string, string> = {
  ...(names.us_stocks ?? {}),
  ...(names.us_etfs ?? {}),
  ...(names.kr_stocks ?? {}),
  ...(names.crypto ?? {}),
};

function resolve(ticker: string): { kr: string | null; type: string } {
  const t = ticker.toUpperCase();
  if (names.us_stocks && t in names.us_stocks) return { kr: names.us_stocks[t as keyof typeof names.us_stocks] as string, type: 'stock' };
  if (names.us_etfs && t in names.us_etfs) return { kr: names.us_etfs[t as keyof typeof names.us_etfs] as string, type: 'etf' };
  if (names.kr_stocks && ticker in names.kr_stocks) return { kr: names.kr_stocks[ticker as keyof typeof names.kr_stocks] as string, type: 'kr' };
  if (names.crypto && t in names.crypto) return { kr: names.crypto[t as keyof typeof names.crypto] as string, type: 'crypto' };
  return { kr: null, type: 'unknown' };
}

const enriched = recs.map((r) => ({ ...r, ...resolve(r.text) }));
---
<section class="card" style="--dot-color: #f59e0b;" aria-label="추천 종목 태그 클라우드">
  <header class="card-head">
    <h2><span class="dot"></span>지난 7일 자주 언급된 종목</h2>
    <span class="dim">{recs.length}개 · 브리핑 본문 빈도 기준</span>
  </header>
  {recs.length === 0 ? (
    <p class="empty">
      <strong>최근 7일 추천 없음.</strong><br />
      브리핑 HTML의 <code>/종목분석 TICKER</code> 명령 코드 블록 추출.<br />
      <span class="dim">/모닝브리핑·/주간리포트 실행 후 자동 갱신.</span>
    </p>
  ) : (
    <div class="cloud">
      {enriched.map((r) => (
        <a class={`tag tag-${r.type}`} href={`/stocks/${r.text}`} title={`/stocks/${r.text} 상세`}>
          <span class="kr">{r.kr ?? r.text}</span>
          <span class="meta">
            {r.kr && <span class="ticker">{r.text}</span>}
            <span class="count" title={`최근 7일 ${r.count}회 언급`}>{r.count}</span>
          </span>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .empty code { background: var(--surface-2); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.78rem; }

  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.25rem 0;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.7rem 0.4rem 0.85rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    transition: border-color .15s, background .15s;
  }
  .tag:hover {
    border-color: var(--accent);
    background: rgba(59,130,246,.08);
  }

  /* 카테고리별 좌측 컬러바 (border-left) */
  .tag-stock   { border-left: 3px solid #3b82f6; }   /* 미국 주식 — blue */
  .tag-etf     { border-left: 3px solid #10b981; }   /* ETF — green */
  .tag-kr      { border-left: 3px solid #f59e0b; }   /* 한국 — amber */
  .tag-crypto  { border-left: 3px solid #a78bfa; }   /* 크립토 — purple */
  .tag-unknown { border-left: 3px solid var(--dim); }

  .kr {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
  }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .ticker {
    color: var(--muted);
    font-size: 0.72rem;
    font-family: 'SF Mono', ui-monospace, Menlo, monospace;
    letter-spacing: .02em;
  }
  .count {
    background: var(--accent);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    min-width: 1.4rem;
    height: 1.4rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 500px) {
    .kr { font-size: 0.85rem; }
    .ticker { display: none; }
    .tag { padding: 0.35rem 0.55rem 0.35rem 0.7rem; }
  }
</style>
