---
// TradingView Stock Heatmap 위젯 — 클릭 시 모달로 확대
// finviz iframe 임베드 차단 사례 발생 → TradingView 공식 임베드 위젯으로 교체 (2026-05-07).
//
// 위젯은 모달 안에 마운트. 처음 열 때만 스크립트 로드, 닫아도 DOM 유지(상태 보존).
---
<section class="hm-card">
  <header class="hm-head">
    <h2><span class="dot"></span>S&P 500 히트맵</h2>
    <span class="dim">TradingView 위젯 · 클릭하여 확대</span>
  </header>

  <button type="button" class="hm-trigger" id="hm-trigger" aria-label="S&P 500 히트맵 열기">
    <div class="hm-preview">
      <div class="hm-preview-grid">
        <span class="b b-up b-l"></span><span class="b b-up b-l"></span><span class="b b-up"></span>
        <span class="b b-up b-l"></span><span class="b b-down"></span><span class="b b-up"></span>
        <span class="b b-up"></span><span class="b b-down"></span><span class="b b-down b-l"></span>
        <span class="b b-up b-l"></span><span class="b b-up"></span><span class="b b-down"></span>
      </div>
    </div>
    <div class="hm-cta">
      <span class="hm-cta-title">전체화면 히트맵 열기 →</span>
      <span class="hm-cta-sub">시간대 토글: 1일 / 1주 / 1개월 / YTD / 1년 (위젯 내부 컨트롤)</span>
    </div>
  </button>

  <div class="hm-links">
    <a href="https://www.tradingview.com/heatmap/stock/?color=change&dataset=SPX500&group=sector&size=market_cap_basic" target="_blank" rel="noopener">TradingView 새 탭 ↗</a>
    <span class="sep">·</span>
    <a href="https://finviz.com/map.ashx?t=sec" target="_blank" rel="noopener">finviz 새 탭 ↗</a>
  </div>
</section>

<!-- 모달 -->
<div id="hm-modal" class="hm-modal" hidden>
  <div class="hm-modal-backdrop" data-close="1"></div>
  <div class="hm-modal-frame" role="dialog" aria-modal="true" aria-label="S&P 500 히트맵">
    <header class="hm-modal-head">
      <span class="hm-modal-title">S&P 500 섹터·종목 히트맵 — TradingView</span>
      <div class="hm-modal-actions">
        <a href="https://www.tradingview.com/heatmap/stock/?color=change&dataset=SPX500&group=sector&size=market_cap_basic" target="_blank" rel="noopener" class="hm-ext">새 탭 ↗</a>
        <button type="button" class="hm-close" data-close="1" aria-label="닫기">✕</button>
      </div>
    </header>
    <div class="hm-iframe-wrap">
      <div class="tradingview-widget-container" id="hm-tv-container">
        <div class="tradingview-widget-container__widget"></div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('hm-modal');
    const trigger = document.getElementById('hm-trigger');
    const tvContainer = document.getElementById('hm-tv-container');
    let mounted = false;

    function mountWidget() {
      if (mounted) return;
      const inner = tvContainer.querySelector('.tradingview-widget-container__widget');
      const script = document.createElement('script');
      script.type = 'text/javascript';
      script.async = true;
      script.src = 'https://s3.tradingview.com/external-embedding/embed-widget-stock-heatmap.js';
      script.text = JSON.stringify({
        exchanges: [],
        dataSource: 'SPX500',
        grouping: 'sector',
        blockSize: 'market_cap_basic',
        blockColor: 'change',
        locale: 'kr',
        symbolUrl: '',
        colorTheme: 'dark',
        hasTopBar: true,
        isDataSetEnabled: false,
        isZoomEnabled: true,
        hasSymbolTooltip: true,
        isMonoSize: false,
        width: '100%',
        height: '100%',
      });
      tvContainer.appendChild(script);
      mounted = true;
    }

    function open() {
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      mountWidget();
    }
    function close() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', open);
    modal.querySelectorAll('[data-close]').forEach((el) => {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  })();
</script>

<style>
  .hm-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.95rem 1.1rem 0.85rem;
  }
  .hm-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.7rem;
    gap: 0.4rem;
  }
  .hm-head h2 {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hm-head .dot {
    width: 8px;
    height: 8px;
    background: #ef4444;
    border-radius: 999px;
    display: inline-block;
  }
  .dim { color: var(--dim); font-size: 0.75rem; }

  .hm-trigger {
    width: 100%;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.7rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    cursor: pointer;
    transition: border-color .15s, background .15s, transform .12s;
    font-family: inherit;
    color: var(--text);
    text-align: left;
  }
  .hm-trigger:hover {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.06);
    transform: translateY(-1px);
  }
  .hm-preview {
    flex-shrink: 0;
    width: 78px;
    height: 60px;
    border-radius: 4px;
    overflow: hidden;
    background: #0a0a0a;
  }
  .hm-preview-grid {
    width: 100%;
    height: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(4, 1fr);
    gap: 1.5px;
  }
  .b { display: block; }
  .b-up { background: #1a8754; }
  .b-up.b-l { background: #2eb872; }
  .b-down { background: #b1453d; }
  .b-down.b-l { background: #d65a52; }
  .hm-cta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .hm-cta-title {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
  }
  .hm-cta-sub {
    font-size: 0.74rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .hm-links {
    margin-top: 0.55rem;
    display: flex;
    gap: 0.5rem;
    align-items: center;
    font-size: 0.72rem;
    color: var(--dim);
  }
  .hm-links a {
    color: var(--accent);
    text-decoration: none;
  }
  .hm-links a:hover { text-decoration: underline; }
  .hm-links .sep { color: var(--dim); }

  /* 모달 */
  .hm-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }
  .hm-modal[hidden] { display: none; }
  .hm-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
  }
  .hm-modal-frame {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    width: 100%;
    max-width: 1280px;
    height: 88vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .hm-modal-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }
  .hm-modal-title {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }
  .hm-modal-actions { display: flex; align-items: center; gap: 0.5rem; }
  .hm-ext { color: var(--accent); font-size: 0.78rem; text-decoration: none; }
  .hm-ext:hover { text-decoration: underline; }
  .hm-close {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--muted);
    width: 32px;
    height: 32px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    font-family: inherit;
  }
  .hm-close:hover { color: var(--text); border-color: var(--down); }
  .hm-iframe-wrap {
    flex: 1;
    position: relative;
    background: #131722;
  }
  .tradingview-widget-container,
  .tradingview-widget-container__widget {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 700px) {
    .hm-modal { padding: 0.6rem; }
    .hm-modal-frame { height: 92vh; }
  }
</style>
