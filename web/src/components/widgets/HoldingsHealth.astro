---
/**
 * HoldingsHealth — 보유 종목 × 분석 신선도 + 손절/목표가 위치.
 * 데이터: web/src/data/holdings_health.json (build_holdings_health.mjs 가 prebuild 생성)
 * 가격은 포트폴리오 md 기록 시점 기준 (실시간 아님 — 헤더에 as-of 표기).
 */
import healthJson from '../../data/holdings_health.json';

interface Analysis {
  v: number | null;
  date: string | null;
  days_since: number | null;
  freshness: 'fresh' | 'aging' | 'stale' | null;
  score: number | null;
  grade: string | null;
  stop_loss: number | null;
  target_price: number | null;
}
interface HoldingRow {
  ticker: string;
  name: string;
  weight_pct: number | null;
  price_md: number | null;
  return_pct: number | null;
  analysis: Analysis | null;
}

const data = healthJson as unknown as {
  generated_at: string;
  portfolio_as_of: string | null;
  holdings: HoldingRow[];
};

const rows = [...data.holdings].sort((a, b) => (b.weight_pct ?? 0) - (a.weight_pct ?? 0));

function gradeTone(grade: string | null): string {
  if (!grade) return 'neutral';
  if (grade.includes('매수')) return 'up';
  if (grade.includes('매도')) return 'down';
  return 'neutral';
}

function freshLabel(a: Analysis | null): string {
  if (!a || a.days_since == null) return '분석 없음';
  return `v${a.v} · ${a.days_since}일 전`;
}

/** 손절~목표 사이 현재가 위치 (0~1). 계산 불가 시 null. */
function rangePos(h: HoldingRow): number | null {
  const a = h.analysis;
  if (!a || a.stop_loss == null || a.target_price == null || h.price_md == null) return null;
  const span = a.target_price - a.stop_loss;
  if (span <= 0) return null;
  return Math.min(1, Math.max(0, (h.price_md - a.stop_loss) / span));
}
---

<section class="card" style="--dot-color: #58a6ff;" aria-label="보유 종목 분석 현황">
  <header class="card-head">
    <h2><span class="dot"></span>보유 종목 분석 현황</h2>
    <span class="dim">가격 기준 {data.portfolio_as_of ?? '—'}</span>
  </header>

  <div class="hh-table" role="table" aria-label="보유 종목별 분석 신선도와 손절·목표가 위치">
    {rows.map((h) => {
      const a = h.analysis;
      const pos = rangePos(h);
      return (
        <div class="hh-row" role="row">
          <div class="hh-ticker" role="cell">
            <a href={`/stocks/${h.ticker}`} title={h.name}>{h.ticker}</a>
            <span class="hh-weight">{h.weight_pct != null ? `${h.weight_pct.toFixed(1)}%` : '—'}</span>
          </div>
          <div class={`hh-grade tone-${gradeTone(a?.grade ?? null)}`} role="cell">
            {a?.grade ?? '—'}{a?.score != null ? ` ${a.score}` : ''}
          </div>
          <div class={`hh-fresh fresh-${a?.freshness ?? 'none'}`} role="cell" title={a?.date ?? ''}>
            <span class="fresh-dot" aria-hidden="true"></span>
            {freshLabel(a)}
          </div>
          <div class="hh-range" role="cell">
            {pos != null && a ? (
              <div class="range-wrap" title={`손절 $${a.stop_loss} → 현재 $${h.price_md} → 목표 $${a.target_price}`}>
                <span class="range-stop">${a.stop_loss}</span>
                <div class="range-bar">
                  <div class="range-marker" style={`left: ${(pos * 100).toFixed(0)}%`}></div>
                </div>
                <span class="range-target">${a.target_price}</span>
              </div>
            ) : (
              <span class="dim-sm">{a?.target_price != null ? `목표 $${a.target_price}` : '—'}</span>
            )}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .hh-table {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hh-row {
    display: grid;
    grid-template-columns: 5.5rem 6.5rem 7.5rem 1fr;
    align-items: center;
    gap: 0.6rem;
    padding: 0.42rem 0.5rem;
    border-radius: 8px;
    font-size: 0.82rem;
  }
  .hh-row:nth-child(odd) {
    background: var(--surface-2, rgba(255, 255, 255, 0.03));
  }
  .hh-ticker a {
    font-weight: 700;
    color: var(--text, inherit);
    text-decoration: none;
  }
  .hh-ticker a:hover {
    color: var(--accent, #58a6ff);
  }
  .hh-weight {
    margin-left: 0.4rem;
    color: var(--text-dim, #9aa0a6);
    font-size: 0.72rem;
  }
  .tone-up { color: var(--up, #3fb950); font-weight: 600; }
  .tone-down { color: var(--down, #f85149); font-weight: 600; }
  .tone-neutral { color: var(--text-dim, #9aa0a6); }
  .hh-fresh {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-dim, #9aa0a6);
    font-size: 0.75rem;
    white-space: nowrap;
  }
  .fresh-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex: none;
    background: #6e7681;
  }
  .fresh-fresh .fresh-dot { background: #3fb950; }
  .fresh-aging .fresh-dot { background: #d29922; }
  .fresh-stale .fresh-dot { background: #f85149; }
  .range-wrap {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }
  .range-stop, .range-target {
    font-size: 0.7rem;
    color: var(--text-dim, #9aa0a6);
    flex: none;
  }
  .range-stop { color: var(--down, #f85149); }
  .range-target { color: var(--up, #3fb950); }
  .range-bar {
    position: relative;
    flex: 1;
    height: 5px;
    border-radius: 3px;
    background: linear-gradient(90deg, rgba(248, 81, 73, 0.45), rgba(110, 118, 129, 0.35), rgba(63, 185, 80, 0.45));
    min-width: 60px;
  }
  .range-marker {
    position: absolute;
    top: -3px;
    width: 3px;
    height: 11px;
    border-radius: 2px;
    background: var(--text, #e8eaed);
    transform: translateX(-50%);
  }
  .dim-sm {
    color: var(--text-dim, #9aa0a6);
    font-size: 0.75rem;
  }
  @media (max-width: 640px) {
    .hh-row {
      grid-template-columns: 4.5rem 5rem 1fr;
    }
    .hh-range { grid-column: 1 / -1; padding-left: 0.1rem; }
  }
</style>
