---
import manifest from '../../data/manifest.json';

interface AnalystItem {
  type: string;
  ticker: string | null;
  name: string | null;
  date: string;
  url_path: string;
  title: string | null;
  source?: string;
  source_type?: string;
  analyst_name?: string;
  rating?: string;
  target_price?: number | null;
  target_currency?: string;
  period?: string;
  summary_bullets?: string[];
}

const LIMIT = 6;
const allAnalyst = manifest.items.filter((it: any) => it.type === 'analyst') as AnalystItem[];
const items = allAnalyst.slice(0, LIMIT);
const total = allAnalyst.length;

const ratingClass = (r?: string): string => {
  if (!r) return 'neutral';
  const rl = r.toLowerCase();
  if (['buy', 'overweight', 'strong buy', 'bullish'].some((k) => rl.includes(k))) return 'buy';
  if (['sell', 'underweight', 'strong sell', 'bearish'].some((k) => rl.includes(k))) return 'sell';
  if (['hold', 'equal weight', 'neutral'].some((k) => rl.includes(k))) return 'hold';
  return 'neutral';
};

const RATING_KO: Record<string, string> = {
  'Buy': '매수', 'Strong Buy': '적극 매수', 'Hold': '보유',
  'Sell': '매도', 'Strong Sell': '적극 매도',
  'Overweight': '비중확대', 'Underweight': '비중축소',
  'Equal Weight': '중립', 'Neutral': '중립',
  'Bullish': '강세', 'Bearish': '약세', 'N/A': '평가 없음',
};
const ratingKo = (r?: string) => (r ? (RATING_KO[r] ?? r) : '');

const sourceTypeLabel: Record<string, string> = {
  ib_official: '🏛️ IB 공식',
  media: '📰 미디어',
  korea_brokerage: '🇰🇷 한국 증권사',
  youtube: '📺 YouTube',
  user_upload: '📄 직접 입수',
};
---
<section class="card analyst-spotlight">
  <header class="card-head">
    <h2><span class="dot" /> 애널리스트 리포트</h2>
    <div class="head-right">
      <span class="dim">총 {total}건</span>
      <a href="/analyst" class="link-all">전체 보기 →</a>
    </div>
  </header>
  {items.length === 0 ? (
    <p class="empty">아직 인덱싱된 애널리스트 리포트가 없습니다.</p>
  ) : (
    <div class="grid">
      {items.map((it) => (
        <a class="ac" href={it.url_path}>
          <div class="row1">
            <span class="badge t-analyst">{it.source ?? it.ticker ?? 'analyst'}</span>
            <span class="date">{it.date}</span>
          </div>
          <div class="row2">
            <span class="target">{it.name}</span>
            {it.rating && <span class:list={['rating', ratingClass(it.rating)]}>{ratingKo(it.rating)}</span>}
          </div>
          {it.title && <h3 class="title">{it.title}</h3>}
          {it.summary_bullets && it.summary_bullets[0] && (
            <p class="lead">{it.summary_bullets[0]}</p>
          )}
          <div class="foot">
            {it.target_price != null ? (
              <span class="tp">목표가 {it.target_currency ?? ''}{it.target_price.toLocaleString()}{it.period ? ` · ${it.period}` : ''}</span>
            ) : <span class="tp dim">목표가 N/A</span>}
            {it.source_type && <span class="src-tag">{sourceTypeLabel[it.source_type] ?? it.source_type}</span>}
          </div>
        </a>
      ))}
    </div>
  )}
</section>

<style>
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.1rem; }
  .card-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .card-head h2 {
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .05em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .card-head .dot {
    width: 8px;
    height: 8px;
    background: var(--t-analyst, #c084fc);
    border-radius: 999px;
    display: inline-block;
  }
  .head-right { display: flex; align-items: center; gap: 0.7rem; }
  .dim { color: var(--dim); font-size: 0.75rem; }
  .link-all { color: var(--accent); font-size: 0.78rem; text-decoration: none; }
  .link-all:hover { text-decoration: underline; }
  .empty { color: var(--muted); font-size: 0.85rem; padding: 1rem; }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.7rem;
  }
  .ac {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 14px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
    transition: border-color .15s, transform .15s, background .15s;
    height: 100%;
  }
  .ac:hover {
    border-color: var(--t-analyst, #c084fc);
    transform: translateY(-1px);
    text-decoration: none;
  }
  .row1 {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
    color: var(--muted);
  }
  .row1 .date { font-variant-numeric: tabular-nums; }
  .badge.t-analyst {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(192, 132, 252, 0.14);
    color: var(--t-analyst, #c084fc);
    font-weight: 600;
  }
  .row2 {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .target {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
  }
  .rating {
    font-size: 10.5px;
    padding: 1px 8px;
    border-radius: 9px;
    background: var(--surface);
    color: var(--muted);
  }
  .rating.buy { background: rgba(16,185,129,.18); color: var(--up); }
  .rating.sell { background: rgba(239,68,68,.18); color: var(--down); }
  .rating.hold { background: rgba(245,158,11,.18); color: var(--warn); }
  .title {
    margin: 4px 0 2px;
    font-size: 12.5px;
    line-height: 1.4;
    font-weight: 500;
    color: var(--text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .lead {
    margin: 0;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .foot {
    margin-top: auto;
    padding-top: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10.5px;
    flex-wrap: wrap;
    gap: 4px;
    font-variant-numeric: tabular-nums;
  }
  .tp { color: var(--text); font-weight: 600; }
  .tp.dim { color: var(--dim); font-weight: 400; }
  .src-tag { color: var(--dim); font-size: 10px; }
</style>
