---
import kb from '../../data/kb.json';

interface FgPoint {
  score: number;
  rating: string;
  prev_close?: number;
  prev_1w?: number;
  prev_1m?: number;
  prev_1y?: number;
  source_ts?: string | null;
  _stale?: boolean;
}

const fg = kb.fear_greed ?? { available: false, cnn: null, crypto: null, updated_at: null };
const cnn: FgPoint | null = fg.cnn;
const crypto: FgPoint | null = fg.crypto;
const updated = fg.updated_at;

// 0-100 점수 → 라벨/색
const RATING_KO: Record<string, string> = {
  'extreme fear': '극도의 공포',
  fear: '공포',
  neutral: '중립',
  greed: '탐욕',
  'extreme greed': '극도의 탐욕',
};

function classify(score: number): { key: string; label: string; tone: string } {
  if (score < 25) return { key: 'extreme-fear', label: '극도의 공포', tone: 'ef' };
  if (score < 45) return { key: 'fear', label: '공포', tone: 'f' };
  if (score < 55) return { key: 'neutral', label: '중립', tone: 'n' };
  if (score < 75) return { key: 'greed', label: '탐욕', tone: 'g' };
  return { key: 'extreme-greed', label: '극도의 탐욕', tone: 'eg' };
}

function deltaTxt(cur: number | undefined, prev: number | undefined): string {
  if (cur == null || prev == null) return '—';
  const d = Math.round((cur - prev) * 10) / 10;
  if (d === 0) return '±0.0';
  const sign = d > 0 ? '+' : '';
  return `${sign}${d.toFixed(1)}`;
}

const cnnView = cnn
  ? {
      score: cnn.score,
      rating: classify(cnn.score),
      d_1d: deltaTxt(cnn.score, cnn.prev_close),
      d_1w: deltaTxt(cnn.score, cnn.prev_1w),
      d_1m: deltaTxt(cnn.score, cnn.prev_1m),
      d_1y: deltaTxt(cnn.score, cnn.prev_1y),
      stale: !!cnn._stale,
    }
  : null;

const cryptoView = crypto
  ? {
      score: crypto.score,
      rating: classify(crypto.score),
      d_1d: deltaTxt(crypto.score, crypto.prev_close),
      d_1w: deltaTxt(crypto.score, crypto.prev_1w),
      d_1m: deltaTxt(crypto.score, crypto.prev_1m),
      d_1y: deltaTxt(crypto.score, crypto.prev_1y),
      stale: !!crypto._stale,
    }
  : null;

// SVG 게이지 — 0-100 → 반원형(180도) 위 점
const W = 220, H = 110, R = 90, CX = W / 2, CY = H;
function arcPath(): string {
  return `M ${CX - R} ${CY} A ${R} ${R} 0 0 1 ${CX + R} ${CY}`;
}
function pointer(score: number) {
  const angle = Math.PI - (score / 100) * Math.PI; // 0=좌, 100=우
  const x = CX + R * Math.cos(angle);
  const y = CY - R * Math.sin(angle);
  return { x, y };
}
const cnnPt = cnnView ? pointer(cnnView.score) : null;
const cryptoPt = cryptoView ? pointer(cryptoView.score) : null;

// 5단계 띠 색상 (0-25-45-55-75-100)
const ZONES = [
  { from: 0, to: 25, color: 'var(--fg-ef)' },
  { from: 25, to: 45, color: 'var(--fg-f)' },
  { from: 45, to: 55, color: 'var(--fg-n)' },
  { from: 55, to: 75, color: 'var(--fg-g)' },
  { from: 75, to: 100, color: 'var(--fg-eg)' },
];
function zoneArc(from: number, to: number): string {
  const a1 = Math.PI - (from / 100) * Math.PI;
  const a2 = Math.PI - (to / 100) * Math.PI;
  const x1 = CX + R * Math.cos(a1);
  const y1 = CY - R * Math.sin(a1);
  const x2 = CX + R * Math.cos(a2);
  const y2 = CY - R * Math.sin(a2);
  return `M ${x1} ${y1} A ${R} ${R} 0 0 1 ${x2} ${y2}`;
}
---
<section class="card fg-card" style="--dot-color: #66c266;">
  <header class="card-head">
    <h2><span class="dot"></span>Fear &amp; Greed Index</h2>
    <div class="fg-head-right">
      <span class="dim">{updated ? `갱신: ${updated.slice(0, 16).replace('T', ' ')}` : '데이터 없음'}</span>
      {(cnnView || cryptoView) && (
        <div class="fg-seg" role="tablist" aria-label="보기 전환">
          <button type="button" class="fg-seg-btn is-on" data-view="gauge" role="tab" aria-selected="true">게이지</button>
          <button type="button" class="fg-seg-btn" data-view="chart" role="tab" aria-selected="false">추이</button>
        </div>
      )}
    </div>
  </header>

  {(!cnnView && !cryptoView) ? (
    <p class="empty">데이터를 가져올 수 없습니다. <code>node web/scripts/fetch_fear_greed.mjs</code> 로 수동 갱신하세요.</p>
  ) : (
    <>
    <div class="fg-chart-view" hidden>
      <div class="fg-controls">
        <div class="fg-seg" aria-label="시장">
          <button type="button" class="fg-seg-btn is-on" data-market="cnn">미국 주식</button>
          <button type="button" class="fg-seg-btn" data-market="crypto">크립토</button>
          <button type="button" class="fg-seg-btn" data-market="both">비교</button>
        </div>
        <div class="fg-seg" aria-label="기간">
          <button type="button" class="fg-seg-btn" data-range="30">1개월</button>
          <button type="button" class="fg-seg-btn" data-range="91">3개월</button>
          <button type="button" class="fg-seg-btn" data-range="182">6개월</button>
          <button type="button" class="fg-seg-btn is-on" data-range="365">1년</button>
          <button type="button" class="fg-seg-btn" data-range="1095">3년</button>
          <button type="button" class="fg-seg-btn" data-range="1825">5년</button>
        </div>
      </div>
      <div class="fg-legend" hidden>
        <span><i class="sw sw-cnn"></i>미국 주식 (CNN)</span>
        <span><i class="sw sw-crypto"></i>크립토 (Alternative.me)</span>
      </div>
      <div class="fg-plot" role="img" aria-label="공포탐욕지수 추이 그래프">
        <p class="fg-plot-msg">불러오는 중…</p>
      </div>
      <div class="fg-stats"></div>
      <p class="fg-note">CNN은 미국 거래일 기준(2021-11~), 크립토는 매일 집계 · 0~100 (25 미만 극도의 공포 / 75 이상 극도의 탐욕)</p>
    </div>
    <div class="fg-grid">
      <!-- CNN (주식) -->
      <div class="fg-pane">
        <div class="fg-pane-head">
          <span class="src">CNN <em>주식 (S&P500 7지표)</em></span>
          {cnnView?.stale && <span class="stale">⚠️ stale</span>}
        </div>
        {cnnView ? (
          <>
            <svg class="gauge" viewBox={`0 0 ${W} ${H + 22}`} role="img" aria-label={`CNN F&G ${cnnView.score}`}>
              {/* 배경 5색 띠 */}
              {ZONES.map((z) => (
                <path d={zoneArc(z.from, z.to)} stroke={z.color} stroke-width="14" fill="none" stroke-linecap="butt" />
              ))}
              {/* 포인터 */}
              {cnnPt && (
                <>
                  <line x1={CX} y1={CY} x2={cnnPt.x} y2={cnnPt.y} stroke="var(--text)" stroke-width="2.5" stroke-linecap="round" />
                  <circle cx={cnnPt.x} cy={cnnPt.y} r="5.5" fill="var(--text)" stroke="var(--surface)" stroke-width="2" />
                </>
              )}
              {/* 눈금 */}
              <text x="8" y={H + 16} class="g-tick">0</text>
              <text x={CX} y={H + 16} text-anchor="middle" class="g-tick">50</text>
              <text x={W - 8} y={H + 16} text-anchor="end" class="g-tick">100</text>
            </svg>
            <div class="fg-score">
              <span class="score-num" data-tone={cnnView.rating.tone}>{cnnView.score}</span>
              <span class="score-label" data-tone={cnnView.rating.tone}>{cnnView.rating.label}</span>
            </div>
            <div class="fg-delta">
              <div><span class="dlabel">전일</span><span class="dval">{cnnView.d_1d}</span></div>
              <div><span class="dlabel">1주</span><span class="dval">{cnnView.d_1w}</span></div>
              <div><span class="dlabel">1개월</span><span class="dval">{cnnView.d_1m}</span></div>
              <div><span class="dlabel">1년</span><span class="dval">{cnnView.d_1y}</span></div>
            </div>
          </>
        ) : (
          <p class="empty">CNN 데이터 없음</p>
        )}
      </div>

      <!-- Crypto -->
      <div class="fg-pane">
        <div class="fg-pane-head">
          <span class="src">Alternative.me <em>크립토 (BTC 변동성·SNS)</em></span>
          {cryptoView?.stale && <span class="stale">⚠️ stale</span>}
        </div>
        {cryptoView ? (
          <>
            <svg class="gauge" viewBox={`0 0 ${W} ${H + 22}`} role="img" aria-label={`Crypto F&G ${cryptoView.score}`}>
              {ZONES.map((z) => (
                <path d={zoneArc(z.from, z.to)} stroke={z.color} stroke-width="14" fill="none" stroke-linecap="butt" />
              ))}
              {cryptoPt && (
                <>
                  <line x1={CX} y1={CY} x2={cryptoPt.x} y2={cryptoPt.y} stroke="var(--text)" stroke-width="2.5" stroke-linecap="round" />
                  <circle cx={cryptoPt.x} cy={cryptoPt.y} r="5.5" fill="var(--text)" stroke="var(--surface)" stroke-width="2" />
                </>
              )}
              <text x="8" y={H + 16} class="g-tick">0</text>
              <text x={CX} y={H + 16} text-anchor="middle" class="g-tick">50</text>
              <text x={W - 8} y={H + 16} text-anchor="end" class="g-tick">100</text>
            </svg>
            <div class="fg-score">
              <span class="score-num" data-tone={cryptoView.rating.tone}>{cryptoView.score}</span>
              <span class="score-label" data-tone={cryptoView.rating.tone}>{cryptoView.rating.label}</span>
            </div>
            <div class="fg-delta">
              <div><span class="dlabel">전일</span><span class="dval">{cryptoView.d_1d}</span></div>
              <div><span class="dlabel">1주</span><span class="dval">{cryptoView.d_1w}</span></div>
              <div><span class="dlabel">1개월</span><span class="dval">{cryptoView.d_1m}</span></div>
              <div><span class="dlabel">1년</span><span class="dval">{cryptoView.d_1y}</span></div>
            </div>
          </>
        ) : (
          <p class="empty">Crypto 데이터 없음</p>
        )}
      </div>
    </div>
    </>
  )}
</section>

<script>
  type Pt = [string, number];
  type Hist = { cnn: Pt[] | null; crypto: Pt[] | null };

  const SVGNS = 'http://www.w3.org/2000/svg';
  const ZONES = [
    { to: 25, label: '극도의 공포', cls: 'ef' },
    { to: 45, label: '공포', cls: 'f' },
    { to: 55, label: '중립', cls: 'n' },
    { to: 75, label: '탐욕', cls: 'g' },
    { to: 100, label: '극도의 탐욕', cls: 'eg' },
  ];
  const NAMES: Record<string, string> = { cnn: '미국 주식', crypto: '크립토' };
  const zoneOf = (v: number) => ZONES.find((z) => v < z.to || z.to === 100)!;
  const dayMs = (d: string) => Date.parse(d + 'T00:00:00Z');
  const fmtDay = (d: string) => d.replace(/-/g, '.');

  const store = {
    get(k: string) { try { return localStorage.getItem('fg.' + k); } catch { return null; } },
    set(k: string, v: string) { try { localStorage.setItem('fg.' + k, v); } catch { /* 무시 */ } },
  };

  function el<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number>, parent?: Element) {
    const n = document.createElementNS(SVGNS, tag);
    for (const [k, v] of Object.entries(attrs)) n.setAttribute(k, String(v));
    parent?.appendChild(n);
    return n;
  }

  function initCard(card: HTMLElement) {
    const chartView = card.querySelector<HTMLElement>('.fg-chart-view');
    const gaugeView = card.querySelector<HTMLElement>('.fg-grid');
    if (!chartView || !gaugeView) return;
    const plot = chartView.querySelector<HTMLElement>('.fg-plot')!;
    const stats = chartView.querySelector<HTMLElement>('.fg-stats')!;
    const legend = chartView.querySelector<HTMLElement>('.fg-legend')!;

    const state = {
      view: store.get('view') === 'chart' ? 'chart' : 'gauge',
      market: store.get('market') ?? 'cnn',
      range: Number(store.get('range') ?? 365),
    };
    let hist: Hist | null = null;
    let loading: Promise<void> | null = null;

    function syncButtons() {
      card.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => {
        const on = b.dataset.view === state.view;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-selected', String(on));
      });
      chartView!.querySelectorAll<HTMLButtonElement>('[data-market]').forEach((b) => b.classList.toggle('is-on', b.dataset.market === state.market));
      chartView!.querySelectorAll<HTMLButtonElement>('[data-range]').forEach((b) => b.classList.toggle('is-on', Number(b.dataset.range) === state.range));
      chartView!.hidden = state.view !== 'chart';
      gaugeView!.hidden = state.view !== 'gauge';
      legend.hidden = state.market !== 'both';
    }

    function load() {
      if (hist || loading) return loading;
      loading = fetch('/fear_greed_history.json', { cache: 'no-cache' })
        .then((r) => { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
        .then((j: Hist) => { hist = j; })
        .catch(() => { plot.innerHTML = '<p class="fg-plot-msg">이력 데이터를 불러오지 못했습니다.</p>'; });
      return loading;
    }

    function render() {
      if (!hist || state.view !== 'chart') return;
      const keys = state.market === 'both' ? ['cnn', 'crypto'] : [state.market];
      const lastDay = keys.map((k) => hist![k as keyof Hist]?.at(-1)?.[0]).filter(Boolean).sort().at(-1);
      if (!lastDay) { plot.innerHTML = '<p class="fg-plot-msg">데이터 없음</p>'; stats.innerHTML = ''; return; }
      const x1 = dayMs(lastDay);
      const x0 = x1 - state.range * 86400000;
      const series = keys.map((k) => ({
        key: k,
        pts: (hist![k as keyof Hist] ?? []).filter((p) => dayMs(p[0]) >= x0).map((p) => ({ d: p[0], t: dayMs(p[0]), v: p[1] })),
      })).filter((s) => s.pts.length > 1);
      if (!series.length) { plot.innerHTML = '<p class="fg-plot-msg">이 기간 데이터 없음</p>'; stats.innerHTML = ''; return; }

      const W = Math.max(280, plot.clientWidth), H = W < 520 ? 220 : 260;
      const m = { l: 30, r: 74, t: 10, b: 24 };
      const iw = W - m.l - m.r, ih = H - m.t - m.b;
      const sx = (t: number) => m.l + ((t - x0) / (x1 - x0)) * iw;
      const sy = (v: number) => m.t + (1 - v / 100) * ih;

      plot.innerHTML = '';
      const svg = el('svg', { viewBox: `0 0 ${W} ${H}`, width: W, height: H, class: 'fgc-svg' }, plot);

      // 구간 띠 + 우측 라벨
      let lo = 0;
      for (const z of ZONES) {
        el('rect', { x: m.l, y: sy(z.to), width: iw, height: sy(lo) - sy(z.to), class: `fgc-band fgc-${z.cls}` }, svg);
        const t = el('text', { x: m.l + iw + 6, y: (sy(lo) + sy(z.to)) / 2 + 3.5, class: 'fgc-zl' }, svg);
        t.textContent = z.label;
        lo = z.to;
      }
      for (const v of [0, 25, 50, 75, 100]) {
        el('line', { x1: m.l, x2: m.l + iw, y1: sy(v), y2: sy(v), class: v === 50 ? 'fgc-mid' : 'fgc-grid' }, svg);
        const t = el('text', { x: m.l - 6, y: sy(v) + 3.5, class: 'fgc-yt', 'text-anchor': 'end' }, svg);
        t.textContent = String(v);
      }
      // x 눈금 — 짧은 기간은 월.일, 긴 기간은 연.월
      const short = state.range <= 182;
      const ticks = Math.max(3, Math.min(6, Math.floor(iw / 90)));
      for (let i = 0; i <= ticks; i++) {
        const t = x0 + ((x1 - x0) * i) / ticks;
        const d = new Date(t).toISOString().slice(0, 10);
        const txt = short ? `${+d.slice(5, 7)}/${+d.slice(8, 10)}` : `${d.slice(2, 4)}.${d.slice(5, 7)}`;
        const n = el('text', { x: sx(t), y: H - 6, class: 'fgc-xt', 'text-anchor': i === 0 ? 'start' : i === ticks ? 'end' : 'middle' }, svg);
        n.textContent = txt;
      }
      // 선
      for (const s of series) {
        const dAttr = s.pts.map((p, i) => `${i ? 'L' : 'M'}${sx(p.t).toFixed(1)},${sy(p.v).toFixed(1)}`).join('');
        el('path', { d: dAttr, class: `fgc-line fgc-line-${s.key}` }, svg);
        const last = s.pts.at(-1)!;
        el('circle', { cx: sx(last.t), cy: sy(last.v), r: 4, class: `fgc-end fgc-line-${s.key}` }, svg);
      }

      // 호버 — 십자선 + 툴팁 (가장 가까운 날짜)
      const cross = el('line', { y1: m.t, y2: m.t + ih, class: 'fgc-cross', visibility: 'hidden' }, svg);
      const dots = series.map((s) => el('circle', { r: 4.5, class: `fgc-dot fgc-line-${s.key}`, visibility: 'hidden' }, svg));
      const tip = document.createElement('div');
      tip.className = 'fgc-tip';
      tip.hidden = true;
      plot.appendChild(tip);
      const hit = el('rect', { x: m.l, y: m.t, width: iw, height: ih, class: 'fgc-hit' }, svg);
      const nearest = (pts: { t: number }[], t: number) => {
        let a = 0, b = pts.length - 1;
        while (b - a > 1) { const c = (a + b) >> 1; if (pts[c].t < t) a = c; else b = c; }
        return Math.abs(pts[a].t - t) <= Math.abs(pts[b].t - t) ? a : b;
      };
      const move = (ev: PointerEvent) => {
        const r = svg.getBoundingClientRect();
        const px = ((ev.clientX - r.left) / r.width) * W;
        const t = x0 + ((px - m.l) / iw) * (x1 - x0);
        const rows: string[] = [];
        let cx = 0, day = '';
        series.forEach((s, i) => {
          const p = s.pts[nearest(s.pts, t)];
          if (i === 0) { cx = sx(p.t); day = p.d; }
          dots[i].setAttribute('cx', String(sx(p.t)));
          dots[i].setAttribute('cy', String(sy(p.v)));
          dots[i].setAttribute('visibility', 'visible');
          rows.push(`<div><i class="sw sw-${s.key}"></i>${NAMES[s.key]} <b>${p.v}</b> <span>${zoneOf(p.v).label}</span></div>`);
        });
        cross.setAttribute('x1', String(cx));
        cross.setAttribute('x2', String(cx));
        cross.setAttribute('visibility', 'visible');
        tip.innerHTML = `<div class="fgc-tip-d">${fmtDay(day)}</div>${rows.join('')}`;
        tip.hidden = false;
        const left = (cx / W) * r.width;
        tip.style.left = `${Math.min(Math.max(left - tip.offsetWidth / 2, 0), r.width - tip.offsetWidth)}px`;
      };
      const leave = () => {
        tip.hidden = true;
        cross.setAttribute('visibility', 'hidden');
        dots.forEach((d) => d.setAttribute('visibility', 'hidden'));
      };
      hit.addEventListener('pointermove', move);
      hit.addEventListener('pointerdown', move);
      hit.addEventListener('pointerleave', leave);

      // 기간 통계
      stats.innerHTML = series.map((s) => {
        const vs = s.pts.map((p) => p.v);
        const avg = vs.reduce((a, b) => a + b, 0) / vs.length;
        const hi = s.pts.reduce((a, b) => (b.v > a.v ? b : a));
        const low = s.pts.reduce((a, b) => (b.v < a.v ? b : a));
        const chg = s.pts.at(-1)!.v - s.pts[0].v;
        const sign = chg > 0 ? '+' : '';
        return `<div class="fgc-stat"><div class="fgc-stat-h"><i class="sw sw-${s.key}"></i>${NAMES[s.key]}</div>
          <div><span>현재</span><b>${s.pts.at(-1)!.v}</b></div>
          <div><span>기간 평균</span><b>${avg.toFixed(1)}</b></div>
          <div><span>최고</span><b>${hi.v}</b><em>${fmtDay(hi.d)}</em></div>
          <div><span>최저</span><b>${low.v}</b><em>${fmtDay(low.d)}</em></div>
          <div><span>기간 변화</span><b>${sign}${chg.toFixed(1)}</b></div></div>`;
      }).join('');
    }

    async function update() {
      syncButtons();
      if (state.view === 'chart') { await load(); render(); }
    }

    card.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
      if (!b) return;
      if (b.dataset.view) { state.view = b.dataset.view; store.set('view', state.view); }
      else if (b.dataset.market) { state.market = b.dataset.market; store.set('market', state.market); }
      else if (b.dataset.range) { state.range = Number(b.dataset.range); store.set('range', String(state.range)); }
      else return;
      update();
    });
    let rz = 0;
    new ResizeObserver(() => { cancelAnimationFrame(rz); rz = requestAnimationFrame(render); }).observe(plot);
    update();
  }

  document.querySelectorAll<HTMLElement>('.fg-card').forEach(initCard);
</script>

<style>
  .fg-card {
    --fg-ef: #d62728;  /* extreme fear */
    --fg-f:  #ff8c42;  /* fear */
    --fg-n:  #cccccc;  /* neutral */
    --fg-g:  #66c266;  /* greed */
