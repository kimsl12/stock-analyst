---
// D2 적중률 도넛 — KB performance_history.md 가 아직 없어 placeholder.
// 파일이 생성되면 자동으로 데이터 표시.
import { existsSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const PROJECT_ROOT = path.resolve(__dirname, '../../../..');
const PERF_FILE = path.join(PROJECT_ROOT, 'knowledge-base', 'performance_history.md');
const hasFile = existsSync(PERF_FILE);
---
<section class="card">
  <header class="card-head">
    <h2>적중률</h2>
    <span class="dim">{hasFile ? '집계 중' : '준비 중'}</span>
  </header>
  <p class="empty">
    {hasFile ? (
      <>performance_history.md 파싱 로직 미구현 (Day 14)</>
    ) : (
      <>
        <strong>knowledge-base/performance_history.md 없음.</strong><br />
        브리핑 추천의 사후 검증 데이터 누적 시작 후 자동 활성화.
      </>
    )}
  </p>
</section>

<style>
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 1rem 1.1rem; min-height: 160px; display: flex; flex-direction: column; }
  .card-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 0.75rem; }
  h2 { margin: 0; font-size: 0.85rem; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .05em; }
  .dim { color: var(--dim); font-size: 0.75rem; }
  .empty {
    color: var(--muted);
    margin: auto 0;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.6;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
</style>
