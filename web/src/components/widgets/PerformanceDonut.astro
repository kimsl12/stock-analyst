---
// D2 적중률 도넛 — knowledge-base/performance_history.md 누적 표 → SVG 4-slice 도넛 (Day 14).
// /성과리뷰 명령이 표에 행을 append. 누적 행 ≥ 1건이면 도넛 활성화.
import kb from '../../data/kb.json';

type Perf = {
  available: boolean;
  total: number;
  hit: number;
  miss: number;
  ongoing: number;
  hold: number;
  hit_rate_pct: number | null;
  last_updated: string | null;
};
const perf = (kb as { performance?: Perf }).performance ?? {
  available: false, total: 0, hit: 0, miss: 0, ongoing: 0, hold: 0, hit_rate_pct: null, last_updated: null,
};

const hasData = perf.total > 0;

// SVG 4-slice 도넛
const RADIUS = 60;
const CIRCUMFERENCE = 2 * Math.PI * RADIUS;
const slices = [
  { label: '적중', value: perf.hit, color: 'var(--up)' },
  { label: '오류', value: perf.miss, color: 'var(--down)' },
  { label: '진행중', value: perf.ongoing, color: 'var(--warning, #f59e0b)' },
  { label: '보류', value: perf.hold, color: 'var(--dim)' },
].filter((s) => s.value > 0);

const total = slices.reduce((s, x) => s + x.value, 0) || 1;
let offset = 0;
const segments = slices.map((s) => {
  const len = CIRCUMFERENCE * (s.value / total);
  const seg = { ...s, dash: len, offset };
  offset += len;
  return seg;
});
---
<section class="card" style="--dot-color: #10b981;" aria-label="성과 도넛 차트">
  <header class="card-head">
    <h2><span class="dot"></span>적중률</h2>
    <span class="dim">{hasData ? `${perf.total}건 누적` : '준비 중'}</span>
  </header>

  {hasData ? (
    <div class="donut-wrap">
      <svg viewBox="0 0 160 160" class="donut" role="img" aria-label="추천 적중률 도넛 차트">
        <title>추천 적중률 도넛 차트</title>
        <circle cx="80" cy="80" r={RADIUS} fill="none" stroke="var(--surface-2)" stroke-width="20" />
        {segments.map((s) => (
          <circle
            cx="80" cy="80" r={RADIUS}
            fill="none"
            stroke={s.color}
            stroke-width="20"
            stroke-dasharray={`${s.dash} ${CIRCUMFERENCE - s.dash}`}
            stroke-dashoffset={-s.offset}
            transform="rotate(-90 80 80)"
          />
        ))}
        <text x="80" y="74" text-anchor="middle" class="donut-center-label">적중률</text>
        <text x="80" y="92" text-anchor="middle" class="donut-center-value">
          {perf.hit_rate_pct == null ? '—' : `${perf.hit_rate_pct}%`}
        </text>
      </svg>
      <ul class="legend">
        <li><span class="legend-dot" style="background:var(--up)"></span><span class="legend-label">적중</span><span class="legend-value">{perf.hit}</span></li>
        <li><span class="legend-dot" style="background:var(--down)"></span><span class="legend-label">오류</span><span class="legend-value">{perf.miss}</span></li>
        <li><span class="legend-dot" style="background:var(--warning, #f59e0b)"></span><span class="legend-label">진행중</span><span class="legend-value">{perf.ongoing}</span></li>
        <li><span class="legend-dot" style="background:var(--dim)"></span><span class="legend-label">보류</span><span class="legend-value">{perf.hold}</span></li>
      </ul>
    </div>
  ) : (
    <p class="empty">
      <strong>아직 누적 데이터 없음.</strong><br />
      <code>/성과리뷰</code> 명령 첫 실행 후 자동 활성화<br />
      <span class="dim">(KB performance_history.md 누적 시작)</span>
    </p>
  )}
</section>

<style>
  .card { min-height: 160px; display: flex; flex-direction: column; }

  .empty {
    color: var(--muted);
    margin: auto 0;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.6;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .empty code { background: var(--surface-2); padding: 0.1rem 0.35rem; border-radius: 4px; font-size: 0.78rem; }

  .donut-wrap { display: grid; grid-template-columns: 160px 1fr; gap: 0.85rem; align-items: center; flex: 1; }
  .donut { width: 160px; height: 160px; }
  .donut-center-label { fill: var(--muted); font-size: 11px; }
  .donut-center-value { fill: var(--text); font-size: 18px; font-weight: 700; }

  .legend { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.35rem; }
  .legend li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; }
  .legend-dot { width: 9px; height: 9px; border-radius: 2px; flex-shrink: 0; display: inline-block; }
  .legend-label { font-size: 0.78rem; flex: 1; color: var(--text); }
  .legend-value { color: var(--muted); font-variant-numeric: tabular-nums; font-size: 0.78rem; font-weight: 600; }

  @media (max-width: 500px) {
    .donut-wrap { grid-template-columns: 1fr; }
    .donut { margin: 0 auto; }
  }
</style>
