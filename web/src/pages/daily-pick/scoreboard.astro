---
import Base from '../../layouts/Base.astro';
import ev from '../../data/daily_pick_eval.json';

// 데일리픽 성적표 — 커밋된 daily_pick_eval.json 만 읽는다 (빌드 시점, 클라이언트 JS 없음)
const e: any = ev;
const { counts, short, long, concentration: conc, pending } = e;

const pct = (n: number | null | undefined) => (n == null ? '—' : `${(n * 100).toFixed(1)}%`);
const sgn = (n: number) => { const r = Number(n.toFixed(1)); return r > 0 ? '+' : r < 0 ? '−' : ''; };
const ret = (n: number | null | undefined) => (n == null ? '—' : `${sgn(n)}${Math.abs(n).toFixed(1)}%`);
const pp = (n: number | null | undefined) => (n == null ? '—' : `${sgn(n)}${Math.abs(n).toFixed(1)}%p`);
const cls = (n: number | null | undefined) => (n == null ? '' : n > 0 ? 'up' : n < 0 ? 'down' : '');
const isKr = (t: string) => /^\d{6}$/.test(t);
const price = (p: number | null | undefined, t: string) =>
  p == null ? '—' : isKr(t) ? `₩${Math.round(p).toLocaleString('en-US')}` : `$${p.toFixed(2)}`;
const md = (d: string | null) => (d ? `${Number(d.slice(5, 7))}/${Number(d.slice(8, 10))}` : '—');
const judgedBy = (j: string) => (j === 'auto-same-version' ? '같은 분석' : j === 'override' ? '수동' : '');

const sS = short.summary;
const lS = long.summary;
const cell = (c: any) => (c == null ? null : c);

// 단기 행 판정 (R2)
const shortVerdict = (r: any) =>
  r.status === 'pending' ? '진입 전' : r.status === 'no_price' ? '가격 없음' : r.h['20'] == null ? '대기' : r.h['20'].hit ? '적중' : '미적중';

// 장기 마감 수익 (마감 후 칸 = 마감 값 고정 → 가장 긴 기간 칸이 마감 값)
const closeRet = (r: any) => {
  if (!r.close) return null;
  for (const k of ['250', '120', '60']) if (r.h[k]) return r.h[k].ret;
  return null;
};

const shortRows = [...short.rows].sort((a: any, b: any) => (a.date < b.date ? 1 : a.date > b.date ? -1 : 0));
const longRecs = [...long.recs].sort((a: any, b: any) => (a.anchor_date < b.anchor_date ? 1 : -1));
const pendingCount = counts.pending;
const closedWithTp = long.recs.filter((r: any) => r.status === 'ok' && r.close != null && r.tp_status !== 'none').length;
const tpSub = `마감 ${closedWithTp}건 중 달성 ${long.close_reasons['달성']} · 진행 중 ${long.close_reasons['진행중']}건` +
  (long.avg_bars_to_tp != null ? ` · 평균 ${long.avg_bars_to_tp.toFixed(1)}거래일` : '') +
  (long.close_reasons['만기'] === 0 ? ' · 만기 사례 없음' : '');
---
<Base title="데일리픽 성적표" lede={`픽 ${counts.picks}건 · 단기 평가완료 ${counts.evaluated_short}건 · 추천 ${counts.recs}건 · 판정 대기 ${pendingCount}건`} active="home">

  <div class="tabs">
    <input type="radio" name="dp-tab" id="tab-short" checked />
    <input type="radio" name="dp-tab" id="tab-long" />
    <div class="tab-labels">
      <label for="tab-short">단기 (20일)</label>
      <label for="tab-long">장기 (120일)</label>
    </div>

    <!-- ================= 단기 ================= -->
    <div class="panel panel-short">
      <section class="kpis">
        <div class="kpi"><div class="k-label">20일 적중률</div><div class="k-val">{pct(sS['20'].hit_rate)}</div><div class="k-sub">n={sS['20'].n} {sS['20'].small_sample && <span class="badge">표본 적음</span>}</div></div>
        <div class="kpi"><div class="k-label">20일 평균 수익</div><div class={`k-val ${cls(sS['20'].avg_return)}`}>{ret(sS['20'].avg_return)}</div><div class="k-sub">절대 수익률</div></div>
        <div class="kpi"><div class="k-label">20일 시장 대비</div><div class={`k-val ${cls(sS['20'].avg_excess)}`}>{pp(sS['20'].avg_excess)}</div><div class="k-sub">초과수익 평균</div></div>
        <div class="kpi"><div class="k-label">5일 적중률</div><div class="k-val">{pct(sS['5'].hit_rate)}</div><div class="k-sub">n={sS['5'].n} {sS['5'].small_sample && <span class="badge">표본 적음</span>}</div></div>
      </section>

      <h2 class="sec-title">기간별</h2>
      <div class="table-wrap"><table>
        <thead><tr><th>기간</th><th class="num">n</th><th class="num">적중률</th><th class="num">평균 수익</th><th class="num">시장 대비</th></tr></thead>
        <tbody>
          {['5', '20'].map((k) => (
            <tr><td>{k}일</td><td class="num">{sS[k].n}{sS[k].small_sample && <span class="badge">표본 적음</span>}</td><td class="num">{pct(sS[k].hit_rate)}</td><td class={`num ${cls(sS[k].avg_return)}`}>{ret(sS[k].avg_return)}</td><td class={`num ${cls(sS[k].avg_excess)}`}>{pp(sS[k].avg_excess)}</td></tr>
          ))}
        </tbody>
      </table></div>

      <h2 class="sec-title">점수대별 <span class="dim">20일 기준</span></h2>
      <div class="table-wrap"><table>
        <thead><tr><th>점수대</th><th class="num">n</th><th class="num">적중률</th><th class="num">평균 수익</th><th class="num">시장 대비</th></tr></thead>
        <tbody>
          {short.by_band.map((b: any) => (
            <tr><td>{b.key}</td><td class="num">{b.n}{b.small_sample && <span class="badge">표본 적음</span>}</td><td class="num">{pct(b.hit_rate)}</td><td class={`num ${cls(b.avg_return)}`}>{ret(b.avg_return)}</td><td class={`num ${cls(b.avg_excess)}`}>{pp(b.avg_excess)}</td></tr>
          ))}
        </tbody>
      </table></div>

      <h2 class="sec-title">장세별 <span class="dim">20일 기준</span></h2>
      <div class="table-wrap"><table>
        <thead><tr><th>장세</th><th class="num">n</th><th class="num">적중률</th><th class="num">평균 수익</th><th class="num">시장 대비</th></tr></thead>
        <tbody>
          {short.by_regime.map((b: any) => (
            <tr><td>{b.key}</td><td class="num">{b.n}{b.small_sample && <span class="badge">표본 적음</span>}</td><td class="num">{pct(b.hit_rate)}</td><td class={`num ${cls(b.avg_return)}`}>{ret(b.avg_return)}</td><td class={`num ${cls(b.avg_excess)}`}>{pp(b.avg_excess)}</td></tr>
          ))}
        </tbody>
      </table></div>

      <h2 class="sec-title">종목 쏠림</h2>
      <p class="note">종목별 균등가중 적중률 <b>{pct(conc.equal_weight_hit_rate)}</b> · 상위 5종목 픽 비중 <b>{pct(conc.top5_share)}</b> <span class="dim">(20일 기준)</span></p>
      <details class="fold">
        <summary>종목별 픽 수·적중률 ({conc.by_ticker.length}종목)</summary>
        <div class="table-wrap"><table>
          <thead><tr><th>종목</th><th class="num">픽 수</th><th class="num">20일 적중률</th></tr></thead>
          <tbody>
            {conc.by_ticker.map((t: any) => (<tr><td>{t.ticker}</td><td class="num">{t.picks}</td><td class="num">{pct(t.hit_rate)}</td></tr>))}
          </tbody>
        </table></div>
      </details>

      <h2 class="sec-title">픽 목록 <span class="dim">{shortRows.length}건 · 최신순</span></h2>
      <div class="table-wrap tall"><table>
        <thead><tr><th>날짜</th><th>종목</th><th class="num">점수</th><th class="num">진입가</th><th class="num">5일</th><th class="num">20일</th><th>판정</th></tr></thead>
        <tbody>
          {shortRows.map((r: any) => (
            <tr>
              <td class="nw">{r.date}</td>
              <td class="nw"><b>{r.name}</b> <span class="dim">{r.ticker}</span></td>
              <td class="num">{r.score}</td>
              <td class="num">{price(r.entry_price, r.ticker)}</td>
              {['5', '20'].map((k) => (
                <td class={`num ${cls(r.h[k]?.ret)}`}>{r.h[k] ? ret(r.h[k].ret) : <span class="dim">{r.status === 'ok' ? '대기' : '—'}</span>}</td>
              ))}
              <td class={`nw v-${shortVerdict(r) === '적중' ? 'hit' : shortVerdict(r) === '미적중' ? 'miss' : 'wait'}`}>{shortVerdict(r)}</td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </div>

    <!-- ================= 장기 ================= -->
    <div class="panel panel-long">
      <section class="kpis">
        <div class="kpi"><div class="k-label">120일 적중률</div><div class="k-val">{pct(lS['120'].hit_rate)}</div><div class="k-sub">n={lS['120'].n} {lS['120'].small_sample && <span class="badge">표본 적음</span>}</div></div>
        <div class="kpi"><div class="k-label">120일 평균 수익</div><div class={`k-val ${cls(lS['120'].avg_return)}`}>{ret(lS['120'].avg_return)}</div><div class="k-sub">절대 수익률</div></div>
        <div class="kpi"><div class="k-label">120일 시장 대비</div><div class={`k-val ${cls(lS['120'].avg_excess)}`}>{pp(lS['120'].avg_excess)}</div><div class="k-sub">초과수익 평균</div></div>
        <div class="kpi"><div class="k-label">목표가 도달률</div><div class="k-val">{pct(long.tp_hit_rate)}</div><div class="k-sub">{tpSub}</div></div>
      </section>
      <p class="note">마감 사유: 달성 {long.close_reasons['달성']} · 논지 교체 {long.close_reasons['논지 교체']} · 만기 {long.close_reasons['만기']} · 진행 중 {long.close_reasons['진행중']}</p>

      <h2 class="sec-title">기간별</h2>
      <div class="table-wrap"><table>
        <thead><tr><th>기간</th><th class="num">n</th><th class="num">적중률</th><th class="num">평균 수익</th><th class="num">시장 대비</th></tr></thead>
        <tbody>
          {['60', '120', '250'].map((k) => (
            <tr><td>{k}일</td><td class="num">{lS[k].n}{lS[k].small_sample && <span class="badge">표본 적음</span>}</td><td class="num">{pct(lS[k].hit_rate)}</td><td class={`num ${cls(lS[k].avg_return)}`}>{ret(lS[k].avg_return)}</td><td class={`num ${cls(lS[k].avg_excess)}`}>{pp(lS[k].avg_excess)}</td></tr>
          ))}
        </tbody>
      </table></div>

      <h2 class="sec-title">점수대별 <span class="dim">120일 기준</span></h2>
      <div class="table-wrap"><table>
        <thead><tr><th>점수대</th><th class="num">n</th><th class="num">적중률</th><th class="num">평균 수익</th><th class="num">시장 대비</th></tr></thead>
        <tbody>
          {long.by_band.map((b: any) => (
            <tr><td>{b.key}</td><td class="num">{b.n}{b.small_sample && <span class="badge">표본 적음</span>}</td><td class="num">{pct(b.hit_rate)}</td><td class={`num ${cls(b.avg_return)}`}>{ret(b.avg_return)}</td><td class={`num ${cls(b.avg_excess)}`}>{pp(b.avg_excess)}</td></tr>
          ))}
        </tbody>
      </table></div>

      <h2 class="sec-title">장세별 <span class="dim">120일 기준</span></h2>
      <div class="table-wrap"><table>
        <thead><tr><th>장세</th><th class="num">n</th><th class="num">적중률</th><th class="num">평균 수익</th><th class="num">시장 대비</th></tr></thead>
        <tbody>
          {long.by_regime.map((b: any) => (
            <tr><td>{b.key}</td><td class="num">{b.n}{b.small_sample && <span class="badge">표본 적음</span>}</td><td class="num">{pct(b.hit_rate)}</td><td class={`num ${cls(b.avg_return)}`}>{ret(b.avg_return)}</td><td class={`num ${cls(b.avg_excess)}`}>{pp(b.avg_excess)}</td></tr>
          ))}
        </tbody>
      </table></div>

      <h2 class="sec-title">종목 쏠림</h2>
      <p class="note">종목별 균등가중 적중률 <b>{pct(conc.equal_weight_hit_rate)}</b> · 상위 5종목 픽 비중 <b>{pct(conc.top5_share)}</b> <span class="dim">(단기 픽 기준)</span></p>

      <h2 class="sec-title">추천 목록 <span class="dim">{longRecs.length}건 · 행을 눌러 재추천 판정 보기</span></h2>
      <div class="table-wrap tall"><table>
        <thead><tr><th>시작일</th><th>종목</th><th class="num">재추천</th><th class="num">진입가</th><th class="num">목표가</th><th class="num">60일</th><th class="num">120일</th><th class="num">250일</th><th>마감</th></tr></thead>
        {longRecs.map((r: any) => (
          <tbody class="rec">
            <tr>
              <td class="nw">{r.anchor_date}</td>
              <td class="nw"><b>{r.name}</b> <span class="dim">{r.ticker}</span>{r.provisional && <span class="badge warn">잠정</span>}</td>
              <td class="num">{r.repicks.length}회</td>
              <td class="num">{r.status === 'ok' ? price(r.entry_price, r.ticker) : r.status === 'pending' ? '진입 전' : '가격 없음'}</td>
              <td class="num">{r.tp_status === 'none' ? <span class="dim">목표가 없음</span> : price(r.tp_price, r.ticker)}</td>
              {['60', '120', '250'].map((k) => (
                <td class={`num ${cls(r.h[k]?.ret)}`}>{r.h[k] ? ret(r.h[k].ret) : <span class="dim">{r.status === 'ok' ? '대기' : '—'}</span>}</td>
              ))}
              <td class="nw">
                {r.provisional ? <span class="dim">{md(r.provisional_from)} 재추천 판정 대기</span>
                  : r.close ? <span>{r.close.reason} · {md(r.close.date)} · <span class={cls(closeRet(r))}>{ret(closeRet(r))}</span></span>
                  : <span class="dim">진행 중{r.tp_status === 'none' ? ' · 목표가 없음' : ''}</span>}
              </td>
            </tr>
            {r.repicks.length > 0 && (
              <tr class="detail-row"><td colspan="9">
                <details>
                  <summary>재추천 {r.repicks.length}회 판정 보기</summary>
                  <ul class="repicks">
                    {r.repicks.map((p: any) => (
                      <li>
                        <span class="nw">{p.date}</span> · <span class="nw">{p.version}</span> · <b class={`vd vd-${p.verdict}`}>{p.verdict}</b>
                        {judgedBy(p.judged_by) && <span class="badge">{judgedBy(p.judged_by)}</span>}
                        {p.rationale && <div class="why">{p.rationale}</div>}
                      </li>
                    ))}
                  </ul>
                </details>
              </td></tr>
            )}
          </tbody>
        ))}
      </table></div>
    </div>
  </div>

  <details class="fold criteria">
    <summary>집계 기준</summary>
    <div class="crit-body">
      <ul>
        <li><b>진입가</b>: 픽일 이후 첫 거래일 종가. N거래일 수익률은 진입 바 기준 N번째 바 종가로 계산하며 휴장일은 건너뜁니다.</li>
        <li><b>벤치마크</b>: 미국 종목·ETF는 S&amp;P500, 한국 종목은 KOSPI(KOSDAQ 포함). 초과수익 = 종목 수익률 − 벤치마크 수익률(%p).</li>
        <li><b>적중</b>: 해당 기간 초과수익 &gt; 0. 단기 메인은 20일, 장기 메인은 120일. 기간이 아직 차지 않은 칸은 <b>대기</b>로 두고 집계에서 제외합니다.</li>
        <li><b>표본 적음</b>: 집계 n &lt; 10 이면 표식을 붙입니다(숫자는 그대로 표시). 점수대는 75–77 / 78–80 / 81+.</li>
        <li><b>단기</b>: 모든 픽을 개별 평가(같은 종목 재픽도 각각). 5일·20일.</li>
        <li><b>장기</b>: 같은 종목의 첫 픽(또는 직전 추천 마감 뒤 첫 픽)이 새 추천의 시작. 열려 있는 동안 재픽되면 논지가 같은지 판정해 <b>동일·보강</b>은 재추천으로 편입, <b>전환</b>은 기존 추천을 마감하고 새 추천을 시작합니다. 판정 전 픽은 <b>판정 대기</b>이며 해당 구간은 확정 전까지 장기 집계에서 제외합니다. 같은 분석 폴더의 재픽은 자동으로 '동일'(같은 분석) 처리합니다.</li>
        <li><b>마감</b>: 시간상 먼저 오는 것. 달성(일중 고가 ≥ 목표가, 청산가 = 목표가, 그 바 시가가 이미 목표가 이상이면 시가) / 논지 교체(전환 픽 진입 바 종가) / 만기(진입 후 250번째 바 종가). 마감 후 기간 칸은 마감 값으로 고정됩니다.</li>
        <li><b>목표가</b>: 각 추천 시작 시점 분석의 목표가. 없거나 진입가 대비 비현실적인 값이면 '목표가 없음'으로 두고 달성 마감은 발생하지 않습니다.</li>
        <li>가격 이력이 없는 종목은 <b>가격 없음</b>, 진입 바가 아직 없는 픽은 <b>진입 전</b>으로 표시하며 집계에서 제외합니다.</li>
      </ul>
    </div>
  </details>
</Base>

<style>
  /* 탭: 라디오 + 형제 선택자 (JS 없음) */
  .tabs > input[type='radio'] { position: absolute; opacity: 0; pointer-events: none; }
  .tab-labels { display: flex; gap: 0.4rem; margin: 0 0 1rem; }
  .tab-labels label {
    padding: 0.45rem 0.9rem; border: 1px solid var(--border); border-radius: 6px;
    background: var(--surface); color: var(--muted); font-size: 0.88rem; font-weight: 600; cursor: pointer;
  }
  #tab-short:checked ~ .tab-labels label[for='tab-short'],
  #tab-long:checked ~ .tab-labels label[for='tab-long'] {
    background: var(--surface-2); color: var(--text); border-color: var(--accent);
  }
  #tab-short:focus-visible ~ .tab-labels label[for='tab-short'],
  #tab-long:focus-visible ~ .tab-labels label[for='tab-long'] { outline: 2px solid var(--accent); outline-offset: 2px; }
  .panel { display: none; }
  #tab-short:checked ~ .panel-short { display: block; }
  #tab-long:checked ~ .panel-long { display: block; }

  .kpis { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin: 0 0 1rem; }
  .kpi { background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 0.8rem 0.9rem; min-width: 0; }
  .k-label { font-size: 0.75rem; color: var(--muted); }
  .k-val { font-size: 1.5rem; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; line-height: 1.3; }
  .k-sub { font-size: 0.75rem; color: var(--muted); }
  @media (max-width: 720px) { .kpis { grid-template-columns: repeat(2, 1fr); } }

  .sec-title { font-size: 1.05rem; font-weight: 700; color: var(--text); margin: 1.6rem 0 0.6rem; }
  .sec-title .dim { font-size: 0.78rem; font-weight: 500; }
  .note { font-size: 0.88rem; color: var(--text); margin: 0 0 0.6rem; }
