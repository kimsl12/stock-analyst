---
import Base from '../../layouts/Base.astro';
import manifest from '../../data/manifest.json';

// [v3.40 — 2026-11-12] 집계 기준 통일: 개인/기관 분리 + 동일인 병합 + 진행자·패널 제외 + 평가 5건 미만 순위 제외.
// 판정 로직은 scripts/lib/analyst_identity.mjs (단위 테스트: scripts/__tests__/analyst_identity.test.mjs)
import { buildAnalystBoard, WEIGHTS } from '../../../scripts/lib/analyst_identity.mjs';

const all = manifest.items.filter((it: any) => it.type === 'analyst') as any[];
const evaluated = all.filter((it) => it.outcome && it.outcome.evaluated_at);
const pending = all.length - evaluated.length;

const ACTIVATION_THRESHOLD = 5;
const isActive = evaluated.length >= ACTIVATION_THRESHOLD;
const MIN_EVALS = 5; // 개인·기관별 순위 산정 최소 평가 건수

const board = buildAnalystBoard(all, { minEvals: MIN_EVALS });
const excludedTotal = Object.values(board.excluded).reduce((a: number, b: any) => a + b, 0);

const pct = (n: number | null) => (n === null ? '—' : `${(n * 100).toFixed(1)}%`);
const err = (n: number | null) => (n === null ? '—' : `${n.toFixed(1)}%`);
const sc = (n: number | null) => (n === null ? '—' : (n * 100).toFixed(0));
const comp = (n: number | null) => (n === null ? '—' : (n * 100).toFixed(1));
---
<Base title="애널리스트 순위·평가" lede={`누적 ${all.length}건 · 평가 완료 ${evaluated.length}건 · 순위 산정 기준 평가 ${MIN_EVALS}건 이상`} active="analyst">

  {!isActive ? (
    <section class="collecting">
      <div class="ico">📊</div>
      <h2>데이터 누적 중</h2>
      <p class="msg">
        애널리스트별 적중률·정확도 순위는 평가 완료된 리포트 <b>{ACTIVATION_THRESHOLD}건 이상</b> 누적 시 활성화됩니다.
      </p>
      <div class="progress-wrap">
        <div class="progress-track">
          <div class="progress-fill" style={`width: ${Math.min(100, (evaluated.length / ACTIVATION_THRESHOLD) * 100)}%`}></div>
        </div>
        <div class="progress-meta">
          <span>{evaluated.length} / {ACTIVATION_THRESHOLD} 평가됨</span>
          <span class="dim">남음 {Math.max(0, ACTIVATION_THRESHOLD - evaluated.length)}건</span>
        </div>
      </div>

      <h3>평가 진행 상황</h3>
      <div class="status-grid">
        <div class="status-card">
          <div class="status-label">총 수집</div>
          <div class="status-val">{all.length}<span class="unit">건</span></div>
        </div>
        <div class="status-card">
          <div class="status-label">평가 완료</div>
          <div class="status-val">{evaluated.length}<span class="unit">건</span></div>
        </div>
        <div class="status-card">
          <div class="status-label">평가 대기</div>
          <div class="status-val">{pending}<span class="unit">건</span></div>
        </div>
      </div>

      <h3>평가 기준</h3>
      <ul class="criteria">
        <li><b>적중률 (가중 0.5)</b> — 목표가 도달 여부 (방향 + ±10% 범위)</li>
        <li><b>정확도 (가중 0.3)</b> — 실제 가격 대비 목표가 오차 % (낮을수록 우수)</li>
        <li><b>논리 점수 (가중 0.2)</b> — 사후 검증된 thesis 타당성 (correct 1.0 / partial 0.5 / incorrect 0)</li>
        <li><b>평가 시점</b> — 발행일로부터 목표 기간의 50% 경과 시</li>
      </ul>

      <p class="how">
        평가 항목은 <code>reports/analyst/items/{`{id}`}/meta.json</code> 의 <code>outcome</code> 필드에 기입됩니다.
        분석 에이전트가 주기적으로 발행 후 충분한 시간이 지난 항목을 자동 평가합니다.
      </p>
    </section>
  ) : (
    <section class="ranked">
      <h2 class="sec-title">개인 순위 <span class="dim">평가 {MIN_EVALS}건 이상 · {board.individuals.length}명</span></h2>
      <div class="table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th class="rank-col">#</th>
              <th>애널리스트</th>
              <th>소속</th>
              <th class="num">평가</th>
              <th class="num">적중률</th>
              <th class="num">평균 오차</th>
              <th class="num">논리</th>
              <th class="num composite">종합</th>
            </tr>
          </thead>
          <tbody>
            {board.individuals.map((a: any, i: number) => (
              <tr>
                <td class="rank-col"><span class:list={['rank-badge', i < 3 && 'top']}>{i + 1}</span></td>
                <td><b>{a.name}</b></td>
                <td class="firm">{a.firm ?? '—'}</td>
                <td class="num">{a.count}</td>
                <td class="num">{pct(a.hit_rate)}<span class="n">{a.n_hit}건</span></td>
                <td class="num">{err(a.avg_error_pct)}<span class="n">{a.n_error}건</span></td>
                <td class="num">{sc(a.thesis)}</td>
                <td class="num composite">{comp(a.composite)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="sec-title">기관 순위 <span class="dim">평가 {MIN_EVALS}건 이상 · {board.firms.length}곳</span></h2>
      <div class="table-wrap">
        <table class="rank-table">
          <thead>
            <tr>
              <th class="rank-col">#</th>
              <th>기관</th>
              <th class="num">개인</th>
              <th class="num">평가</th>
              <th class="num">적중률</th>
              <th class="num">평균 오차</th>
              <th class="num">논리</th>
              <th class="num composite">종합</th>
            </tr>
          </thead>
          <tbody>
            {board.firms.map((a: any, i: number) => (
              <tr>
                <td class="rank-col"><span class:list={['rank-badge', i < 3 && 'top']}>{i + 1}</span></td>
                <td><b>{a.name}</b></td>
                <td class="num">{a.people}명</td>
                <td class="num">{a.count}</td>
                <td class="num">{pct(a.hit_rate)}<span class="n">{a.n_hit}건</span></td>
                <td class="num">{err(a.avg_error_pct)}<span class="n">{a.n_error}건</span></td>
                <td class="num">{sc(a.thesis)}</td>
                <td class="num composite">{comp(a.composite)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <details class="fold">
        <summary>표본 부족 — 평가 {MIN_EVALS}건 미만 (순위 미산정) · 개인 {board.lowSample.individuals.length}명 · 기관 {board.lowSample.firms.length}곳</summary>
        <div class="low-grid">
          <div>
            <h3>개인</h3>
            <ul class="low-list">
              {board.lowSample.individuals.map((a: any) => (
                <li><span class="nm">{a.name}</span>{a.firm && <span class="dim"> · {a.firm}</span>}<span class="meta">{a.count}건 · 적중 {pct(a.hit_rate)}</span></li>
              ))}
            </ul>
          </div>
          <div>
            <h3>기관</h3>
            <ul class="low-list">
              {board.lowSample.firms.map((a: any) => (
                <li><span class="nm">{a.name}</span><span class="meta">{a.count}건 · 적중 {pct(a.hit_rate)}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </details>

      <details class="fold">
        <summary>집계 기준</summary>
        <ul class="criteria rules">
          <li><b>개인</b> — 실명 1인 단위. 괄호 속 소속·직함, 쉼표 뒤 직함은 이름에서 떼고 같은 사람으로 합칩니다 (예: "Tom Lee (Fundstrat)" = "Tom Lee", "Michael Wilson" = "Mike Wilson", "마이클 하트넷" = "Michael Hartnett").</li>
          <li><b>진행자 제외</b> — 방송 진행자·앵커·기자는 예측 주체가 아니므로 빼고 봅니다. 진행자를 뺀 뒤 실명이 1인인 항목만 그 사람에게 산입합니다.</li>
          <li><b>공동 저자·패널</b> — 2인 이상은 개인 순위에 넣지 않습니다. 전원이 같은 기관(증권사 공동 리포트 등)이면 그 기관에만 산입하고, 기관이 섞인 방송 패널은 제외합니다.</li>
          <li><b>기관</b> — 소속 개인의 단독 항목과 팀·기관 명의 리포트를 합산합니다. 기관명은 표기를 통일하고(JP Morgan·JP모간·JPMorgan AM → JPMorgan, 하나금융투자 → 하나증권) 계열사는 모그룹으로 묶습니다. 한 사람은 항상 대표 소속(가장 많이 표기된 소속) 하나로만 집계합니다.</li>
          <li><b>순위 제외</b> — 매체 진행진·편집부, 컨센서스 종합, 익명·출처 미상 항목. 현재 {excludedTotal}건 (패널 {board.excluded.panel ?? 0} · 매체 {board.excluded.media ?? 0} · 익명 {board.excluded.anonymous ?? 0} · 컨센서스 {board.excluded.consensus ?? 0}).</li>
          <li><b>최소 표본</b> — 평가 완료 {MIN_EVALS}건 미만은 순위를 매기지 않고 위 "표본 부족" 목록에만 표시합니다.</li>
          <li><b>종합 점수</b> — 적중률 {WEIGHTS.hit} · 정확도(1 − 평균 오차%) {WEIGHTS.error} · 논리 {WEIGHTS.thesis}. 적중 판정·오차·논리 판정이 없는 항목은 그 지표에서 빼고, 데이터가 없는 지표는 가중치를 나머지에 재배분합니다(빈 값을 만점·0점으로 채우지 않음). 부분 적중은 0.5.</li>
        </ul>
      </details>

      {pending > 0 && (
        <p class="dim small">※ 추가로 {pending} 건이 평가 대기 중입니다 (목표 기간 미도달).</p>
      )}
    </section>
  )}

</Base>

<style>
  .collecting {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    text-align: center;
  }
  .collecting .ico { font-size: 2.5rem; margin-bottom: 0.4rem; }
  .collecting h2 { font-size: 1.3rem; margin: 0 0 0.6rem; color: var(--text); font-weight: 700; }
  .collecting .msg { color: var(--muted); font-size: 0.95rem; margin: 0 auto 1.5rem; max-width: 540px; line-height: 1.6; }
  .collecting .msg b { color: var(--accent); font-weight: 700; }

  .progress-wrap { max-width: 480px; margin: 0 auto 2rem; }
  .progress-track {
    height: 14px;
    background: var(--surface-2);
    border-radius: 999px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--t-analyst, #c084fc), var(--accent));
    transition: width 0.4s ease;
  }
  .progress-meta {
    display: flex;
    justify-content: space-between;
    margin-top: 0.5rem;
    font-size: 0.8rem;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .collecting h3 {
    margin: 1.5rem 0 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    max-width: 600px;
    margin: 0 auto;
  }
  .status-card {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem;
  }
  .status-label { font-size: 0.75rem; color: var(--muted); }
  .status-val {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .status-val .unit { font-size: 0.85rem; color: var(--muted); margin-left: 4px; }

  .criteria {
    text-align: left;
    max-width: 640px;
    margin: 0 auto;
    padding-left: 1.4rem;
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--text);
  }
  .criteria b { color: var(--accent); }

  .how {
    color: var(--muted);
    font-size: 0.8rem;
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--border);
  }
  .how code {
    font-family: 'SF Mono', ui-monospace, Menlo, monospace;
    background: var(--surface-2);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.78rem;
  }

  .ranked .rank-table {
    width: 100%;
    border-collapse: collapse;
  }
  .ranked th, .ranked td {
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
    font-size: 0.88rem;
  }
  .ranked th {
    background: var(--surface-2);
    font-weight: 600;
    color: var(--muted);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ranked .num { text-align: right; font-variant-numeric: tabular-nums; }
  .ranked .composite { font-weight: 700; color: var(--accent); }
  .rank-col { width: 48px; text-align: center; }
  .rank-badge {
    display: inline-block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--muted);
    font-weight: 700;
    line-height: 28px;
    text-align: center;
    font-size: 0.85rem;
  }
  .rank-badge.top {
    background: linear-gradient(135deg, #fbbf24, #fb923c);
    color: #0F1923;
  }

  .badge.t-analyst {
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 8px;
    background: rgba(192, 132, 252, 0.14);
    color: var(--t-analyst, #c084fc);
    font-weight: 600;
  }
  .small { font-size: 0.78rem; margin-top: 1rem; }

  .sec-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin: 2rem 0 0.75rem;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .ranked > .sec-title:first-child { margin-top: 0; }
  .sec-title .dim { font-size: 0.8rem; font-weight: 500; color: var(--muted); }
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .ranked .rank-table tr:last-child td { border-bottom: none; }
  .ranked th, .ranked td.num { white-space: nowrap; }
  .ranked td.firm { color: var(--muted); font-size: 0.82rem; }
  .ranked .n {
    display: block;
    font-size: 0.68rem;
    color: var(--muted);
    font-weight: 400;
  }

  .fold {
    margin-top: 1.5rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .fold summary {
    cursor: pointer;
    padding: 0.8rem 1rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text);
  }
  .fold[open] summary { border-bottom: 1px solid var(--border); }
  .low-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem 2rem;
    padding: 0.8rem 1rem 1rem;
  }
  .low-grid h3 { font-size: 0.8rem; color: var(--muted); margin: 0 0 0.4rem; font-weight: 600; }
  .low-list { list-style: none; margin: 0; padding: 0; font-size: 0.82rem; }
  .low-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.3rem;
    padding: 0.3rem 0;
    border-bottom: 1px dashed var(--border);
  }
  .low-list .nm { color: var(--text); font-weight: 600; }
  .low-list .meta { margin-left: auto; color: var(--muted); font-variant-numeric: tabular-nums; }
  .criteria.rules { padding: 0.8rem 1rem 1rem 2.2rem; margin: 0; max-width: none; }
</style>
