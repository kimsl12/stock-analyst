---
import Base from '../../layouts/Base.astro';
import { createServerClient, type Portfolio, type Holding } from '../../lib/supabase.ts';

// P2-6: 빌드 시점 health.json 읽기 (없으면 status='unknown')
let health: { status: string; reason: string | null; checked_at: string; checks: Array<{ name: string; ok: boolean; detail: string }> } = {
  status: 'unknown', reason: null, checked_at: '', checks: [],
};
try {
  health = (await import('../../data/health.json')).default as typeof health;
} catch {
  /* graceful — health.json 없을 수 있음 (첫 빌드) */
}

// 빌드 시점 SSG: service_role 키로 RLS 우회 → portfolios + holdings 읽기
const sb = createServerClient();

let portfolio: Portfolio | null = null;
let holdings: Holding[] = [];
let error: string | null = null;

if (!sb) {
  error = 'Supabase 환경변수 미설정 (PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_KEY)';
} else {
  try {
    const { data: pData, error: pErr } = await sb
      .from('portfolios')
      .select('*')
      .order('updated_at', { ascending: false })
      .limit(1);
    if (pErr) throw pErr;
    portfolio = (pData?.[0] as Portfolio | undefined) ?? null;

    if (portfolio) {
      const { data: hData, error: hErr } = await sb
        .from('holdings')
        .select('*')
        .eq('portfolio_id', portfolio.id)
        .order('weight_pct', { ascending: false, nullsFirst: false });
      if (hErr) throw hErr;
      holdings = (hData as Holding[]) ?? [];
    }
  } catch (e) {
    error = `Supabase 조회 실패: ${(e as Error).message}`;
  }
}

// [v3.32] Supabase 행에 KRW 총액·환율이 비어 있으면 user_portfolio.md 에서 빌드 시점 폴백
// (총액(KRW)·환율 카드가 '—' 로 비어 보이던 문제)
if (portfolio && (portfolio.total_value_krw == null || portfolio.exchange_rate == null)) {
  try {
    const { readFileSync } = await import('node:fs');
    const path = await import('node:path');
    const mdPath = path.resolve(process.cwd(), '..', 'knowledge-base/portfolio/user_portfolio.md');
    const lib = await import('../../../scripts/lib/portfolio_parser.mjs');
    const lines = lib.extractCurrentSection(readFileSync(mdPath, 'utf-8')).split('\n');
    const totals = lib.parseTotals(lines);
    if (portfolio.total_value_krw == null && totals?.total_value_krw != null) {
      portfolio.total_value_krw = totals.total_value_krw;
    }
    if (portfolio.exchange_rate == null && totals?.exchange_rate != null) {
      portfolio.exchange_rate = totals.exchange_rate;
    }
  } catch { /* md 폴백 실패 시 기존 '—' 유지 */ }
}

// [v3.32] 프로파일 값의 마크다운 링크 → 텍스트 정리 ("[라벨](경로)" 원문 노출 문제)
if (portfolio?.profile) {
  for (const [k, v] of Object.entries(portfolio.profile)) {
    if (typeof v === 'string') {
      (portfolio.profile as Record<string, string>)[k] = v
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
        .replace(/\\_/g, '_')
        .replace(/\*\*/g, '');
    }
  }
}

// [v3.34] 알고 자동매매 채널 — 엔진이 쓰는 algo-trading/data/algo_holdings.json (계약: algo_engine_handoff.md §9)
// 파일 부재·스키마 불일치 시 섹션만 비표시하고 빌드는 진행 (graceful)
type AlgoPosition = {
  ticker: string; name: string; channel: string; strategy_type: string | null;
  qty: number; entry_price: number | null; entry_date: string | null;
  current_price: number | null; current_value: number | null; return_pct: number | null;
  stop_price: number | null; target_price: number | null; stop_mode: string | null;
  score_at_entry: number | null;
};
type AlgoTrade = {
  executed_at: string; ticker: string; name: string; action: string;
  qty: number; price: number; reason: string | null; reason_code: string | null;
};
type AlgoHoldings = {
  schema_version?: string; generated_at?: string; engine_status?: string;
  cash_krw?: number | null; positions?: AlgoPosition[]; trades?: AlgoTrade[];
};
let algo: AlgoHoldings | null = null;
try {
  const { readFileSync } = await import('node:fs');
  const path = await import('node:path');
  const algoPath = path.resolve(process.cwd(), '..', 'algo-trading/data/algo_holdings.json');
  const parsed = JSON.parse(readFileSync(algoPath, 'utf-8')) as AlgoHoldings;
  if (parsed?.schema_version === 'algo-holdings-v1') algo = parsed;
} catch { /* 엔진 미연동 또는 파싱 실패 — 섹션 비표시 */ }
const algoPositions: AlgoPosition[] = (algo?.positions ?? []).filter((p) => p && p.ticker);
const algoTrades: AlgoTrade[] = (algo?.trades ?? []).filter((t) => t && t.ticker).slice(0, 20);
const algoLive = algo?.engine_status === 'live';
const algoTotalKrw = algoPositions.reduce((s, p) => s + (p.current_value ?? 0), 0);
const CHANNEL_LABEL: Record<string, string> = { algo: '자동', manual_managed: '재량+관리' };
const REASON_LABEL: Record<string, string> = {
  ENTRY: '진입', STOP: '손절', TRAIL_STOP: '트레일링 익절', TARGET: '목표 도달',
  TIME_EXIT: '기간 초과', GRADE_EXIT: '등급 하락', REGIME_EXIT: '레짐 전환',
  EMERGENCY: '긴급 청산', REPLACE: '종목 교체',
};

const fmtMoney = (v: number | null, currency: 'USD' | 'KRW' = 'USD') => {
  if (v == null) return '—';
  const opts: Intl.NumberFormatOptions = currency === 'USD'
    ? { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }
    : { style: 'currency', currency: 'KRW', maximumFractionDigits: 0 };
  return new Intl.NumberFormat('en-US', opts).format(v);
};
const fmtPct = (v: number | null) => (v == null ? '—' : `${v >= 0 ? '+' : ''}${v.toFixed(2)}%`);
const fmtQty = (v: number | null) => (v == null ? '—' : v.toLocaleString('en-US', { maximumFractionDigits: 6 }));
// Supabase는 timestamptz를 UTC로 저장하지만, 사용자 표시는 KST 기준으로 변환
const updatedAt = portfolio?.updated_at
  ? new Intl.DateTimeFormat('sv-SE', {
      timeZone: 'Asia/Seoul',
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      hour12: false,
    }).format(new Date(portfolio.updated_at))
  : null;
---
<Base
  title="내 포트폴리오"
  lede={portfolio
    ? `최종 갱신: ${updatedAt} (KST) · ${holdings.length}개 보유 종목`
    : '데이터 없음 — /내포트폴리오 명령으로 동기화 후 다시 방문'}
  active="portfolio"
>
  {error && <div class="err">{error}</div>}

  <div class={`health-badge health-${health.status}`} title={health.reason ?? '데이터 검증 통과'}>
    {health.status === 'healthy' && <>✅ 데이터 검증 통과 ({health.checks.filter((c) => c.ok).length}/{health.checks.length})</>}
    {health.status === 'unhealthy' && <>⚠️ 데이터 무결성 경고 — {health.reason}</>}
    {health.status === 'unknown' && <>ℹ️ 헬스체크 미실행 (로컬 빌드 또는 환경변수 미설정)</>}
    <span class="checked-at"> · {health.checked_at ? new Date(health.checked_at).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', hour12: false }) : '—'} (KST)</span>
  </div>

  {portfolio && (
    <>
      <section class="totals">
        <div class="metric">
          <div class="metric-label">총액 (USD)</div>
          <div class="metric-value">{fmtMoney(portfolio.total_value_usd, 'USD')}</div>
        </div>
        <div class="metric">
          <div class="metric-label">총액 (KRW)</div>
          <div class="metric-value">{fmtMoney(portfolio.total_value_krw, 'KRW')}</div>
        </div>
        <div class="metric">
          <div class="metric-label">환율</div>
          <div class="metric-value">{portfolio.exchange_rate ? `${portfolio.exchange_rate.toFixed(2)}원` : '—'}</div>
        </div>
        <div class="metric">
          <div class="metric-label">출처</div>
          <div class="metric-value">{portfolio.source}</div>
        </div>
      </section>

      <section>
        <h2>투자자 프로파일</h2>
        <table class="profile">
          <tbody>
            {Object.entries(portfolio.profile ?? {}).map(([k, v]) => (
              <tr><th>{k}</th><td>{v}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <section>
        <h2>보유 종목 — 직접 매매 ({holdings.length}건) <span class="channel-tag tag-manual">수동 동기화</span></h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>티커</th>
                <th>이름</th>
                <th>유형</th>
                <th class="num">수량</th>
                <th class="num">평가금</th>
                <th class="num">비중</th>
                <th class="num">수익률</th>
              </tr>
            </thead>
            <tbody>
              {holdings.map((h) => (
                <tr>
                  <td><strong>{h.ticker}</strong></td>
                  <td>{h.name}</td>
                  <td><span class="muted">{h.asset_type ?? '—'}</span></td>
                  <td class="num">{fmtQty(h.quantity)}</td>
                  <td class="num">{fmtMoney(h.current_value_usd, 'USD')}</td>
                  <td class="num">{h.weight_pct == null ? '—' : `${h.weight_pct.toFixed(2)}%`}</td>
                  <td class:list={['num', h.return_pct != null && (h.return_pct >= 0 ? 'up' : 'down')]}>
                    {fmtPct(h.return_pct)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}

  <section class="algo-section">
    <h2 class="algo-title"><span class="channel-tag tag-algo">🤖 ALGO</span> 알고 자동매매 — 토스증권 엔진 체결분</h2>

    {!algo && (
      <div class="algo-empty">엔진 연동 데이터 없음 — algo_holdings.json 미존재 또는 형식 오류</div>
    )}

    {algo && algoPositions.length === 0 && (
      <div class="algo-empty">
        {algoLive
          ? '현재 보유 포지션 없음 — 엔진 가동 중 (전량 현금 또는 진입 대기)'
          : '알고 매매 엔진 연동 대기 중 — 엔진이 가동되면 보유 포지션과 체결 내역이 여기에 자동 표시됩니다.'}
      </div>
    )}

    {algoPositions.length > 0 && (
      <>
        <div class="algo-summary">
          <span class="chip">포지션 {algoPositions.length}건</span>
          <span class="chip">평가액 {fmtMoney(algoTotalKrw, 'KRW')}</span>
          {algo?.cash_krw != null && <span class="chip">예수금 {fmtMoney(algo?.cash_krw ?? null, 'KRW')}</span>}
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>티커</th>
                <th>종목명</th>
                <th>구분</th>
                <th class="num">수량</th>
                <th class="num">진입가</th>
                <th class="num">현재가</th>
                <th class="num">평가금</th>
                <th class="num">수익률</th>
                <th class="num">손절가</th>
                <th class="num">목표가</th>
                <th>모드</th>
              </tr>
            </thead>
            <tbody>
              {algoPositions.map((p) => (
                <tr>
                  <td><strong>{p.ticker}</strong></td>
                  <td>{p.name}</td>
                  <td><span class="muted">{CHANNEL_LABEL[p.channel] ?? p.channel}{p.strategy_type ? ` · ${p.strategy_type}` : ''}</span></td>
                  <td class="num">{fmtQty(p.qty)}</td>
                  <td class="num">{fmtMoney(p.entry_price, 'KRW')}</td>
                  <td class="num">{fmtMoney(p.current_price, 'KRW')}</td>
                  <td class="num">{fmtMoney(p.current_value, 'KRW')}</td>
                  <td class:list={['num', p.return_pct != null && (p.return_pct >= 0 ? 'up' : 'down')]}>
                    {fmtPct(p.return_pct)}
                  </td>
                  <td class="num">{fmtMoney(p.stop_price, 'KRW')}</td>
                  <td class="num">{fmtMoney(p.target_price, 'KRW')}</td>
                  <td><span class="muted">{p.stop_mode ?? '—'}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    {algoTrades.length > 0 && (
      <>
        <h3 class="algo-sub">최근 체결 ({algoTrades.length}건)</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>체결 시각</th>
                <th>종목</th>
                <th>매수/매도</th>
                <th class="num">수량</th>
                <th class="num">가격</th>
                <th>사유</th>
              </tr>
            </thead>
            <tbody>
              {algoTrades.map((t) => (
                <tr>
                  <td class="muted">{t.executed_at}</td>
                  <td><strong>{t.ticker}</strong> {t.name}</td>
                  <td class={t.action === 'buy' ? 'up' : 'down'}>{t.action === 'buy' ? '매수' : '매도'}</td>
                  <td class="num">{fmtQty(t.qty)}</td>
                  <td class="num">{fmtMoney(t.price, 'KRW')}</td>
                  <td>{t.reason_code ? `[${REASON_LABEL[t.reason_code] ?? t.reason_code}] ` : ''}{t.reason ?? ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )}

    <div class="algo-meta">
      엔진 마지막 보고: {algo?.generated_at ?? '—'} · 상태: {algo?.engine_status ?? '—'} · 사이트 자동 반영 06:40 / 10:30 / 16:15 (KST)
    </div>
  </section>
</Base>

<style>
  .err {
    padding: 1rem 1.25rem;
    background: rgba(239,68,68,.1);
    border: 1px solid rgba(239,68,68,.4);
    border-radius: 8px;
    color: var(--down);
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }
  .health-badge {
    padding: 0.55rem 0.85rem;
    border-radius: 6px;
    font-size: 0.78rem;
    margin-bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  .health-healthy {
    background: rgba(16,185,129,.10);
    border: 1px solid rgba(16,185,129,.35);
    color: #10b981;
  }
  .health-unhealthy {
    background: rgba(245,158,11,.10);
    border: 1px solid rgba(245,158,11,.45);
    color: #f59e0b;
  }
  .health-unknown {
    background: rgba(156,163,175,.10);
    border: 1px solid rgba(156,163,175,.30);
    color: var(--muted);
  }
  .checked-at {
    color: var(--muted);
    font-size: 0.72rem;
  }
  .totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.7rem;
    margin-bottom: 1.5rem;
  }
  .metric {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }
  .metric-label {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  .metric-value {
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  h2 {
    font-size: 1rem;
    color: var(--muted);
    margin: 1.5rem 0 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  table.profile { max-width: 640px; }
  table.profile th { width: 40%; }

  .table-wrap { overflow-x: auto; }

  /* [v3.34] 채널 구분 — 직접 매매(수동) vs 알고 자동매매 */
  .channel-tag {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 600;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    vertical-align: middle;
    text-transform: none;
  }
  .tag-manual {
    background: rgba(156,163,175,.15);
    border: 1px solid rgba(156,163,175,.35);
    color: var(--muted);
  }
  .tag-algo {
    background: rgba(139,92,246,.18);
    border: 1px solid rgba(139,92,246,.5);
    color: #a78bfa;
  }
  .algo-section {
    margin-top: 2rem;
    padding: 1rem 1.25rem 1.1rem;
    border: 1px solid rgba(139,92,246,.3);
    border-left: 3px solid #8b5cf6;
    border-radius: 10px;
    background: rgba(139,92,246,.04);
  }
  .algo-section .algo-title { margin-top: 0; }
  .algo-sub {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 1.25rem 0 0.6rem;
    font-weight: 500;
  }
  .algo-summary {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
  }
  .chip {
    font-size: 0.76rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-variant-numeric: tabular-nums;
  }
  .algo-empty {
    font-size: 0.84rem;
    color: var(--muted);
    padding: 0.6rem 0.2rem;
  }
  .algo-meta {
    margin-top: 0.85rem;
    font-size: 0.72rem;
    color: var(--muted);
  }
</style>
