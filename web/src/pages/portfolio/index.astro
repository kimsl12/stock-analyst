---
import Base from '../../layouts/Base.astro';
import { createServerClient, type Portfolio, type Holding } from '../../lib/supabase.ts';

// P2-6: 빌드 시점 health.json 읽기 (없으면 status='unknown')
let health: { status: string; reason: string | null; checked_at: string; checks: Array<{ name: string; ok: boolean; detail: string }> } = {
  status: 'unknown', reason: null, checked_at: '', checks: [],
};
try {
  health = (await import('../../data/health.json')).default as typeof health;
} catch {
  /* graceful — health.json 없을 수 있음 (첫 빌드) */
}

// 빌드 시점 SSG: service_role 키로 RLS 우회 → portfolios + holdings 읽기
const sb = createServerClient();

let portfolio: Portfolio | null = null;
let holdings: Holding[] = [];
let error: string | null = null;

if (!sb) {
  error = 'Supabase 환경변수 미설정 (PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_KEY)';
} else {
  try {
    const { data: pData, error: pErr } = await sb
      .from('portfolios')
      .select('*')
      .order('updated_at', { ascending: false })
      .limit(1);
    if (pErr) throw pErr;
    portfolio = (pData?.[0] as Portfolio | undefined) ?? null;

    if (portfolio) {
      const { data: hData, error: hErr } = await sb
        .from('holdings')
        .select('*')
        .eq('portfolio_id', portfolio.id)
        .order('weight_pct', { ascending: false, nullsFirst: false });
      if (hErr) throw hErr;
      holdings = (hData as Holding[]) ?? [];
    }
  } catch (e) {
    error = `Supabase 조회 실패: ${(e as Error).message}`;
  }
}

// [v3.32] Supabase 행에 KRW 총액·환율이 비어 있으면 user_portfolio.md 에서 빌드 시점 폴백
// (총액(KRW)·환율 카드가 '—' 로 비어 보이던 문제)
if (portfolio && (portfolio.total_value_krw == null || portfolio.exchange_rate == null)) {
  try {
    const { readFileSync } = await import('node:fs');
    const path = await import('node:path');
    const mdPath = path.resolve(process.cwd(), '..', 'knowledge-base/portfolio/user_portfolio.md');
    const lib = await import('../../../scripts/lib/portfolio_parser.mjs');
    const lines = lib.extractCurrentSection(readFileSync(mdPath, 'utf-8')).split('\n');
    const totals = lib.parseTotals(lines);
    if (portfolio.total_value_krw == null && totals?.total_value_krw != null) {
      portfolio.total_value_krw = totals.total_value_krw;
    }
    if (portfolio.exchange_rate == null && totals?.exchange_rate != null) {
      portfolio.exchange_rate = totals.exchange_rate;
    }
  } catch { /* md 폴백 실패 시 기존 '—' 유지 */ }
}

// [v3.32] 프로파일 값의 마크다운 링크 → 텍스트 정리 ("[라벨](경로)" 원문 노출 문제)
if (portfolio?.profile) {
  for (const [k, v] of Object.entries(portfolio.profile)) {
    if (typeof v === 'string') {
      (portfolio.profile as Record<string, string>)[k] = v
        .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
        .replace(/\\_/g, '_')
        .replace(/\*\*/g, '');
    }
  }
}

const fmtMoney = (v: number | null, currency: 'USD' | 'KRW' = 'USD') => {
  if (v == null) return '—';
  const opts: Intl.NumberFormatOptions = currency === 'USD'
    ? { style: 'currency', currency: 'USD', maximumFractionDigits: 2 }
    : { style: 'currency', currency: 'KRW', maximumFractionDigits: 0 };
  return new Intl.NumberFormat('en-US', opts).format(v);
};
const fmtPct = (v: number | null) => (v == null ? '—' : `${v >= 0 ? '+' : ''}${v.toFixed(2)}%`);
const fmtQty = (v: number | null) => (v == null ? '—' : v.toLocaleString('en-US', { maximumFractionDigits: 6 }));
// Supabase는 timestamptz를 UTC로 저장하지만, 사용자 표시는 KST 기준으로 변환
const updatedAt = portfolio?.updated_at
  ? new Intl.DateTimeFormat('sv-SE', {
      timeZone: 'Asia/Seoul',
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', second: '2-digit',
      hour12: false,
    }).format(new Date(portfolio.updated_at))
  : null;
---
<Base
  title="내 포트폴리오"
  lede={portfolio
    ? `최종 갱신: ${updatedAt} (KST) · ${holdings.length}개 보유 종목`
    : '데이터 없음 — /내포트폴리오 명령으로 동기화 후 다시 방문'}
  active="portfolio"
>
  {error && <div class="err">{error}</div>}

  <div class={`health-badge health-${health.status}`} title={health.reason ?? '데이터 검증 통과'}>
    {health.status === 'healthy' && <>✅ 데이터 검증 통과 ({health.checks.filter((c) => c.ok).length}/{health.checks.length})</>}
    {health.status === 'unhealthy' && <>⚠️ 데이터 무결성 경고 — {health.reason}</>}
    {health.status === 'unknown' && <>ℹ️ 헬스체크 미실행 (로컬 빌드 또는 환경변수 미설정)</>}
    <span class="checked-at"> · {health.checked_at ? new Date(health.checked_at).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', hour12: false }) : '—'} (KST)</span>
  </div>

  {portfolio && (
    <>
      <section class="totals">
        <div class="metric">
          <div class="metric-label">총액 (USD)</div>
          <div class="metric-value">{fmtMoney(portfolio.total_value_usd, 'USD')}</div>
        </div>
        <div class="metric">
          <div class="metric-label">총액 (KRW)</div>
          <div class="metric-value">{fmtMoney(portfolio.total_value_krw, 'KRW')}</div>
        </div>
        <div class="metric">
          <div class="metric-label">환율</div>
          <div class="metric-value">{portfolio.exchange_rate ? `${portfolio.exchange_rate.toFixed(2)}원` : '—'}</div>
        </div>
        <div class="metric">
          <div class="metric-label">출처</div>
          <div class="metric-value">{portfolio.source}</div>
        </div>
      </section>

      <section>
        <h2>투자자 프로파일</h2>
        <table class="profile">
          <tbody>
            {Object.entries(portfolio.profile ?? {}).map(([k, v]) => (
              <tr><th>{k}</th><td>{v}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <section>
        <h2>보유 종목 ({holdings.length}건)</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>티커</th>
                <th>이름</th>
                <th>유형</th>
                <th class="num">수량</th>
                <th class="num">평가금</th>
                <th class="num">비중</th>
                <th class="num">수익률</th>
              </tr>
            </thead>
            <tbody>
              {holdings.map((h) => (
                <tr>
                  <td><strong>{h.ticker}</strong></td>
                  <td>{h.name}</td>
                  <td><span class="muted">{h.asset_type ?? '—'}</span></td>
                  <td class="num">{fmtQty(h.quantity)}</td>
                  <td class="num">{fmtMoney(h.current_value_usd, 'USD')}</td>
                  <td class="num">{h.weight_pct == null ? '—' : `${h.weight_pct.toFixed(2)}%`}</td>
                  <td class:list={['num', h.return_pct != null && (h.return_pct >= 0 ? 'up' : 'down')]}>
                    {fmtPct(h.return_pct)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    </>
  )}
</Base>

<style>
  .err {
    padding: 1rem 1.25rem;
    background: rgba(239,68,68,.1);
    border: 1px solid rgba(239,68,68,.4);
    border-radius: 8px;
    color: var(--down);
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
  }
  .health-badge {
    padding: 0.55rem 0.85rem;
    border-radius: 6px;
    font-size: 0.78rem;
    margin-bottom: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  .health-healthy {
    background: rgba(16,185,129,.10);
    border: 1px solid rgba(16,185,129,.35);
    color: #10b981;
  }
  .health-unhealthy {
    background: rgba(245,158,11,.10);
    border: 1px solid rgba(245,158,11,.45);
    color: #f59e0b;
  }
  .health-unknown {
    background: rgba(156,163,175,.10);
    border: 1px solid rgba(156,163,175,.30);
    color: var(--muted);
  }
  .checked-at {
    color: var(--muted);
    font-size: 0.72rem;
  }
  .totals {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 0.7rem;
    margin-bottom: 1.5rem;
  }
  .metric {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1rem;
  }
  .metric-label {
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
  .metric-value {
    font-size: 1.15rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  h2 {
    font-size: 1rem;
    color: var(--muted);
    margin: 1.5rem 0 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: .04em;
  }

  table.profile { max-width: 640px; }
  table.profile th { width: 40%; }

  .table-wrap { overflow-x: auto; }
</style>
