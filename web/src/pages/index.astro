---
import Base from '../layouts/Base.astro';
import StatCard from '../components/widgets/StatCard.astro';
import FearGreedGauge from '../components/widgets/FearGreedGauge.astro';
import MarketHeatmap from '../components/widgets/MarketHeatmap.astro';
import MacroIndicators from '../components/widgets/MacroIndicators.astro';
import MarketSnapshot from '../components/widgets/MarketSnapshot.astro';
import HoldingsDonut from '../components/widgets/HoldingsDonut.astro';
import HoldingsHealth from '../components/widgets/HoldingsHealth.astro';
import RecentReports from '../components/widgets/RecentReports.astro';
import RecentAnalyst from '../components/widgets/RecentAnalyst.astro';
import DailyPick from '../components/widgets/DailyPick.astro';
import EconomicCalendar from '../components/widgets/EconomicCalendar.astro';
import RecommendCloud from '../components/widgets/RecommendCloud.astro';
import ResearchKBStatus from '../components/widgets/ResearchKBStatus.astro';
import PerformanceDonut from '../components/widgets/PerformanceDonut.astro';

import manifest from '../data/manifest.json';
import kb from '../data/kb.json';
import { createServerClient, type Portfolio, type Holding } from '../lib/supabase.ts';

// P2-6: portfolio 헬스체크 결과 (build 시점 prebuild 가 생성)
type HealthPayload = { status: 'healthy' | 'unhealthy' | 'unknown'; reason: string | null; checked_at: string; checks?: Array<{ name: string; ok: boolean; detail: string }> };
let health: HealthPayload = { status: 'unknown', reason: null, checked_at: '', checks: [] };
try {
  health = (await import('../data/health.json')).default as HealthPayload;
} catch {
  /* graceful */
}

// --- 포트폴리오 (A1, A2, A3 데이터) ---
const sb = createServerClient();
let portfolio: Portfolio | null = null;
let holdings: Holding[] = [];
if (sb) {
  try {
    const { data: p } = await sb.from('portfolios').select('*').order('updated_at', { ascending: false }).limit(1);
    portfolio = (p?.[0] as Portfolio | undefined) ?? null;
    if (portfolio) {
      const { data: h } = await sb
        .from('holdings').select('*')
        .eq('portfolio_id', portfolio.id)
        .order('weight_pct', { ascending: false, nullsFirst: false });
      holdings = (h as Holding[]) ?? [];
    }
  } catch {
    /* graceful */
  }
}

// --- F1: 마지막 브리핑 시각 / 활동성 ---
const briefingTypes = ['morning', 'evening', 'weekly', 'crypto', 'user_portfolio', 'global_intelligence', 'model_portfolio', 'rebalancing'];
const briefingItems = manifest.items.filter((it) => briefingTypes.includes(it.type));
const latestBriefing = briefingItems[0];
const lastBriefingDate = latestBriefing?.date;
// KST 기준 오늘 (한국 새벽 1시면 UTC는 전날 16시 — 날짜 경계 차이 보정)
const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul' }).format(new Date());
const daysSince = lastBriefingDate ? Math.floor((Date.parse(today) - Date.parse(lastBriefingDate)) / 86400000) : null;
const sinceLabel = daysSince == null ? '—' : daysSince === 0 ? '오늘' : daysSince === 1 ? '어제' : `${daysSince}일 전`;

// --- F2: KB 건강 ---
const { p0, p1, last_lint } = kb.kb_health;
const kbTone = p0 > 0 ? 'down' : p1 > 5 ? 'warn' : 'up';
const kbValue = p0 > 0 ? `P0 ${p0}건 🚨` : p1 > 0 ? `P1 ${p1}건` : '정상';

// --- A1: 포트폴리오 총액 ---
const totalUsd = portfolio?.total_value_usd;
const totalKrw = portfolio?.total_value_krw;
const fx = portfolio?.exchange_rate;
const updatedAt = portfolio?.updated_at?.slice(0, 10);
const totalUsdFmt = totalUsd != null ? `$${totalUsd.toLocaleString('en-US', { maximumFractionDigits: 2 })}` : '—';
const totalKrwFmt = totalKrw != null ? `₩${totalKrw.toLocaleString('en-US', { maximumFractionDigits: 0 })}` : '—';
---
<Base title="대시보드" lede={`Astro+Supabase 통합 뷰 · ${manifest.count}건 인덱스`} active="home">
  <!-- 최상단: 오늘의 추천 종목 (DailyPick v3.22) -->
  <section class="row">
    <DailyPick />
  </section>

  <!-- Fear & Greed (왼쪽) + S&P 500 히트맵 (오른쪽) -->
  <section class="row fg-row">
    <FearGreedGauge />
    <MarketHeatmap />
  </section>

  <!-- 매크로 지표 (FRED 15시리즈) -->
  <section class="row">
    <MacroIndicators />
  </section>

  <!-- 상단: 4개 StatCard 그리드 -->
  <section class="row stats">
    <StatCard
      label="포트폴리오 총액 (USD)"
      value={totalUsdFmt}
      sub={totalKrwFmt + (fx ? ` · ${fx.toFixed(2)}원` : '')}
      href="/portfolio"
    />
    <StatCard
      label="포트폴리오 갱신"
      value={updatedAt ?? '—'}
      sub={portfolio ? `source: ${portfolio.source}` : '데이터 없음'}
    />
    <StatCard
      label="마지막 브리핑"
      value={sinceLabel}
      sub={latestBriefing ? `${latestBriefing.type} · ${lastBriefingDate}` : '없음'}
      href={latestBriefing?.url_path}
    />
    <StatCard
      label="KB 건강 상태"
      value={kbValue}
      sub={last_lint ? `last lint: ${last_lint}` : 'wiki-linter 미실행'}
      tone={kbTone as 'up' | 'down' | 'warn'}
    />
    <StatCard
      label="포트폴리오 데이터 헬스"
      value={health.status === 'healthy' ? '정상' : health.status === 'unhealthy' ? '경고' : '미확인'}
      sub={health.status === 'unhealthy' ? (health.reason ?? '검증 실패') : (health.checks ? `${health.checks.filter((c) => c.ok).length}/${health.checks.length} 통과` : '미실행')}
      tone={(health.status === 'healthy' ? 'up' : health.status === 'unhealthy' ? 'warn' : 'warn') as 'up' | 'down' | 'warn'}
      href="/portfolio"
    />
  </section>

  <!-- 중단 좌: 시장 스냅샷 / 우: 보유 도넛 -->
  <section class="row two-col">
    <MarketSnapshot />
    <HoldingsDonut holdings={holdings} />
  </section>

  <!-- 보유 종목 × 분석 신선도 + 손절/목표가 위치 -->
  <section class="row">
    <HoldingsHealth />
  </section>

  <!-- 경제 캘린더 (의사결정 핵심, 시장 스냅샷 직후 배치) -->
  <section class="row">
    <EconomicCalendar />
  </section>

  <!-- 애널리스트 리포트 -->
  <section class="row">
    <RecentAnalyst />
  </section>

  <!-- 활동: 최근 리포트 + 추천 클라우드 + 적중률 -->
  <section class="row three-col">
    <RecentReports />
    <RecommendCloud />
    <PerformanceDonut />
  </section>

  <!-- Research KB 활용 KPI (v3.19) -->
  <section class="row">
    <ResearchKBStatus />
  </section>
</Base>

<style>
  .row { margin-bottom: 1rem; }
  .row.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0.75rem; }
  .row.two-col { display: grid; grid-template-columns: 1.5fr 1fr; gap: 0.75rem; }
  .row.three-col { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .row.fg-row { display: grid; grid-template-columns: 2fr 1fr; gap: 0.75rem; align-items: start; }

  @media (max-width: 900px) {
    .row.two-col { grid-template-columns: 1fr; }
    .row.three-col { grid-template-columns: 1fr; }
    .row.fg-row { grid-template-columns: 1fr; }
  }
</style>
