---
import Base from '../../layouts/Base.astro';
---
<Base
  title="비밀번호 설정"
  lede="이메일 링크로 들어왔습니다 — 새 비밀번호를 설정하세요"
  active={null}
  noAuth={true}
>
  <section class="callback">
    <div id="state" class="state pending">인증 토큰 검증 중…</div>

    <form id="pw-form" novalidate style="display:none;">
      <label for="newpw">새 비밀번호</label>
      <input
        type="password"
        id="newpw"
        name="newpw"
        required
        minlength="8"
        autocomplete="new-password"
        placeholder="8자 이상"
      />

      <label for="newpw2">비밀번호 확인</label>
      <input
        type="password"
        id="newpw2"
        name="newpw2"
        required
        minlength="8"
        autocomplete="new-password"
        placeholder="다시 한 번"
      />

      <button type="submit" id="save-btn">비밀번호 저장</button>
    </form>

    <div id="hint" class="hint"></div>
    <div id="actions" class="actions" style="display:none;">
      <a href="/login" class="btn">로그인 페이지로 돌아가기</a>
    </div>
  </section>
</Base>

<script>
  import { createBrowserClient } from '../../lib/supabase';
  import { enforceWhitelist, updatePassword } from '../../lib/auth';

  const stateEl = document.getElementById('state') as HTMLDivElement;
  const hintEl = document.getElementById('hint') as HTMLDivElement;
  const actionsEl = document.getElementById('actions') as HTMLDivElement;
  const formEl = document.getElementById('pw-form') as HTMLFormElement;
  const saveBtn = document.getElementById('save-btn') as HTMLButtonElement;

  function fail(msg: string) {
    stateEl.className = 'state err';
    stateEl.textContent = `❌ ${msg}`;
    actionsEl.style.display = 'block';
  }
  function pending(msg: string) {
    stateEl.className = 'state pending';
    stateEl.textContent = msg;
  }
  function ok(msg: string) {
    stateEl.className = 'state ok';
    stateEl.textContent = `✅ ${msg}`;
  }

  (async () => {
    const sb = createBrowserClient();
    if (!sb) {
      fail('Supabase 클라이언트 초기화 실패 (환경변수 확인 필요)');
      return;
    }

    // detectSessionInUrl: true 설정으로 hash의 access_token 자동 파싱
    await new Promise((r) => setTimeout(r, 150));

    // URL hash/query 에러 파라미터 체크
    const hashParams = new URLSearchParams(window.location.hash.slice(1));
    const queryParams = new URLSearchParams(window.location.search);
    const errParam = hashParams.get('error') || queryParams.get('error');
    const errDesc = hashParams.get('error_description') || queryParams.get('error_description');
    if (errParam) {
      fail(`${errParam}: ${errDesc ?? '인증 실패'}`);
      return;
    }

    // 화이트리스트 검증 (임시 세션 = recovery 토큰의 임시 인증)
    const result = await enforceWhitelist();
    if (!result.ok) {
      if (result.reason === 'not-allowed') {
        fail(`허용되지 않은 이메일입니다: ${result.email ?? '(unknown)'}`);
        hintEl.textContent = '관리자에게 문의하거나 등록된 이메일로 다시 시도하세요. 세션은 자동 종료되었습니다.';
      } else if (result.reason === 'no-user') {
        fail('인증 토큰이 만료되었거나 잘못되었습니다.');
        hintEl.textContent = '로그인 페이지에서 비밀번호 재설정 링크를 다시 받으세요.';
      } else {
        fail('인증 처리 실패');
      }
      return;
    }

    // recovery 모드 — 새 비번 입력 폼 표시
    pending('인증 완료. 새 비밀번호를 설정하세요.');
    hintEl.textContent = `이메일: ${result.email}`;
    formEl.style.display = 'flex';
    (document.getElementById('newpw') as HTMLInputElement)?.focus();
  })();

  // 새 비밀번호 저장
  formEl?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const pw1 = (document.getElementById('newpw') as HTMLInputElement).value;
    const pw2 = (document.getElementById('newpw2') as HTMLInputElement).value;

    if (pw1 !== pw2) {
      hintEl.textContent = '❌ 두 비밀번호가 일치하지 않습니다.';
      hintEl.style.color = 'var(--down)';
      return;
    }
    if (pw1.length < 8) {
      hintEl.textContent = '❌ 비밀번호는 8자 이상이어야 합니다.';
      hintEl.style.color = 'var(--down)';
      return;
    }

    saveBtn.disabled = true;
    saveBtn.textContent = '저장 중…';
    hintEl.textContent = '';

    const r = await updatePassword(pw1);

    if (!r.ok) {
      saveBtn.disabled = false;
      saveBtn.textContent = '비밀번호 저장';
      hintEl.textContent = `❌ ${r.error}`;
      hintEl.style.color = 'var(--down)';
      return;
    }

    ok('비밀번호 저장 완료. 홈으로 이동합니다…');
    hintEl.textContent = '다음부터는 이 비밀번호로 로그인하세요.';
    hintEl.style.color = 'var(--muted)';
    formEl.style.display = 'none';

    setTimeout(() => {
      const next = new URLSearchParams(window.location.search).get('next') || '/';
      window.location.replace(next);
    }, 1200);
  });
</script>

<style>
  .callback {
    max-width: 480px;
    margin: 2rem auto;
    padding: 1.75rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
  }
  .state { font-size: 1.05rem; font-weight: 600; text-align: center; margin-bottom: 1rem; }
  .state.pending { color: var(--muted); }
  .state.ok { color: var(--up); }
  .state.err { color: var(--down); }

  form { display: none; flex-direction: column; gap: .6rem; margin-top: .5rem; }
  label {
    font-size: .8rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .04em;
  }
  input {
    padding: .6rem .8rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-size: .95rem;
    font-family: inherit;
  }
  input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  button {
    margin-top: .35rem;
    padding: .65rem 1rem;
    background: var(--accent);
    color: #fff;
    border: 0;
    border-radius: 6px;
    font-weight: 600;
    font-size: .95rem;
    cursor: pointer;
    font-family: inherit;
  }
  button:hover:not(:disabled) { background: var(--accent-2); }
  button:disabled { opacity: .55; cursor: wait; }

  .hint {
    margin-top: .85rem;
    color: var(--muted);
    font-size: .85rem;
    line-height: 1.5;
    text-align: center;
  }
  .actions { margin-top: 1.25rem; text-align: center; }
  .btn {
    display: inline-block;
    padding: .55rem 1rem;
    background: var(--accent);
    color: #fff;
    border-radius: 6px;
    font-weight: 600;
    font-size: .9rem;
  }
  .btn:hover { background: var(--accent-2); text-decoration: none; }
</style>
