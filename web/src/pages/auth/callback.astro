---
import Base from '../../layouts/Base.astro';
---
<Base
  title="인증 처리 중…"
  lede="잠시만 기다려주세요"
  active={null}
  noAuth={true}
>
  <section class="callback">
    <div id="state" class="state pending">매직 링크 검증 중…</div>
    <div id="hint" class="hint"></div>
    <div id="actions" class="actions" style="display:none;">
      <a href="/login" class="btn">로그인 페이지로 돌아가기</a>
    </div>
  </section>
</Base>

<script>
  import { createBrowserClient } from '../../lib/supabase';
  import { enforceWhitelist } from '../../lib/auth';

  const stateEl = document.getElementById('state') as HTMLDivElement;
  const hintEl = document.getElementById('hint') as HTMLDivElement;
  const actionsEl = document.getElementById('actions') as HTMLDivElement;

  function fail(msg: string) {
    stateEl.className = 'state err';
    stateEl.textContent = `❌ ${msg}`;
    actionsEl.style.display = 'block';
  }
  function ok(msg: string) {
    stateEl.className = 'state ok';
    stateEl.textContent = `✅ ${msg}`;
  }

  (async () => {
    const sb = createBrowserClient();
    if (!sb) {
      fail('Supabase 클라이언트 초기화 실패 (환경변수 확인 필요)');
      return;
    }

    // detectSessionInUrl: true 설정으로 자동 파싱되지만, 명시적 대기.
    // URL의 access_token / refresh_token이 LocalStorage에 저장될 때까지 짧게 대기.
    await new Promise((r) => setTimeout(r, 100));

    // URL hash 또는 query에 에러 파라미터가 있으면 즉시 차단
    const hashParams = new URLSearchParams(window.location.hash.slice(1));
    const queryParams = new URLSearchParams(window.location.search);
    const errParam = hashParams.get('error') || queryParams.get('error');
    const errDesc =
      hashParams.get('error_description') || queryParams.get('error_description');
    if (errParam) {
      fail(`${errParam}: ${errDesc ?? '인증 실패'}`);
      return;
    }

    // 화이트리스트 검증
    const result = await enforceWhitelist();
    if (!result.ok) {
      if (result.reason === 'not-allowed') {
        fail(`허용되지 않은 이메일입니다: ${result.email ?? '(unknown)'}`);
        hintEl.textContent =
          '관리자에게 문의하거나 등록된 이메일로 다시 시도해주세요. 세션은 자동 종료되었습니다.';
      } else if (result.reason === 'no-user') {
        fail('인증 세션을 찾을 수 없습니다. 매직 링크가 만료되었을 수 있습니다.');
      } else {
        fail('인증 처리 실패');
      }
      return;
    }

    ok(`로그인 성공: ${result.email}`);
    hintEl.textContent = '잠시 후 이동합니다…';

    // next 파라미터로 리다이렉트 (없으면 홈)
    const next = queryParams.get('next') || '/';
    setTimeout(() => {
      // history 오염 방지: replace
      window.location.replace(next);
    }, 700);
  })();
</script>

<style>
  .callback {
    max-width: 480px;
    margin: 2rem auto;
    padding: 1.75rem 1.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    text-align: center;
  }
  .state { font-size: 1.05rem; font-weight: 600; }
  .state.pending { color: var(--muted); }
  .state.ok { color: var(--up); }
  .state.err { color: var(--down); }
  .hint {
    margin-top: .85rem;
    color: var(--muted);
    font-size: .85rem;
    line-height: 1.5;
  }
  .actions { margin-top: 1.25rem; }
  .btn {
    display: inline-block;
    padding: .55rem 1rem;
    background: var(--accent);
    color: #fff;
    border-radius: 6px;
    font-weight: 600;
    font-size: .9rem;
  }
  .btn:hover { background: var(--accent-2); text-decoration: none; }
</style>
