---
import Base from '../layouts/Base.astro';
import kpi from '../data/research_kpi.json';
import manifest from '../data/manifest.json';

const totals = kpi.totals as {
  l1_total: number; l2_total: number; l3_total: number;
  active_sectors: number; scaffolded_sectors: number;
};
const usage = kpi.usage as {
  stocks_with_citations: number; total_citations: number; avg_citations_per_stock: number;
  recent_cases: Array<{
    ticker: string; name: string; version: string;
    sector: string | null; sector_label: string;
    analyzed_at: string; citations_count: number; citations: string[];
  }>;
  sector_usage: Record<string, number>;
};
const sectors = kpi.sectors as Array<{
  id: string; label: string; emoji: string; priority: number;
  status: string; last_updated: string | null;
  l1_count: number; l2_count: number; l3_count: number;
  l3_latest_quarter: string | null; thesis_summary: string | null;
  usage_count: number;
}>;

// manifest 에서 L3 HTML 항목 추출 (link 용)
const l3Items = (manifest.items as Array<{ url_path?: string; filename?: string; type?: string; sector?: string; quarter?: string }>)
  .filter((it) => it.type === 'research');

function l3Link(sectorId: string, quarter: string | null): string | null {
  if (!quarter) return null;
  const hit = l3Items.find((it) => it.sector === sectorId && it.quarter === quarter);
  if (hit?.url_path) return hit.url_path;
  return `/reports/research/${sectorId}_${quarter}.html`;
}

const statusLabel: Record<string, string> = {
  early: '초기 (활용 5건 미만)',
  active: '활성',
  stable: '안정',
};

// 섹터별 사용 비율 (총 인용 기준)
const totalUsage = Object.values(usage.sector_usage).reduce((a, b) => a + b, 0) || 1;
const usageBars = sectors
  .map((s) => ({
    label: s.label,
    emoji: s.emoji,
    count: s.usage_count,
    pct: Math.round((s.usage_count / totalUsage) * 1000) / 10,
  }))
  .sort((a, b) => b.count - a.count);
const maxUsage = Math.max(...usageBars.map((u) => u.count), 1);
---
<Base title="📑 Research KB" lede={`학술·씽크탱크·컨퍼런스·규제 1차 자료 ${totals.l1_total + totals.l2_total + totals.l3_total}건 → 종목 분석 ${usage.stocks_with_citations}건에 ${usage.total_citations}개 인용 (${kpi.kpi_status === 'early' ? '초기 단계' : kpi.kpi_status})`} active="research">

  <!-- 상단 4 KPI -->
  <section class="kpi-row">
    <div class="kpi">
      <div class="kpi-label">총 인사이트</div>
      <div class="kpi-value">{totals.l1_total + totals.l2_total + totals.l3_total}</div>
      <div class="kpi-sub">L1 헤드라인 {totals.l1_total} · L2 요약 {totals.l2_total} · L3 분기 {totals.l3_total}</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">활성 섹터</div>
      <div class="kpi-value">{totals.active_sectors}<span class="kpi-frac"> / {totals.active_sectors + totals.scaffolded_sectors}</span></div>
      <div class="kpi-sub">신규 {totals.scaffolded_sectors}섹터 1차 수집 대기</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">인용 적용 종목</div>
      <div class="kpi-value">{usage.stocks_with_citations}</div>
      <div class="kpi-sub">평균 {usage.avg_citations_per_stock}건/종목 · 총 {usage.total_citations} 인용</div>
    </div>
    <div class="kpi">
      <div class="kpi-label">시스템 상태</div>
      <div class={`kpi-value kpi-status status-${kpi.kpi_status}`}>{statusLabel[kpi.kpi_status] ?? kpi.kpi_status}</div>
      <div class="kpi-sub">데이터 갱신 {kpi.generated_at}</div>
    </div>
  </section>

  <!-- 어떻게 동작하나 -->
  <section class="explain">
    <h2>🧭 어디에 어떻게 쓰이나</h2>
    <ol>
      <li><strong>매주 일요일</strong> — research-curator 가 10섹터 × 4유형 (학술·씽크탱크·컨퍼런스·규제) 헤드라인을 L1 인덱스에 수집</li>
      <li><strong>매월 첫째 주</strong> — 누적 L1 중 핵심을 L2 요약본으로 승격 (섹터별 .md 파일)</li>
      <li><strong>분기 첫째 주</strong> — L2 5건 이상 누적 시 L3 분기 Deep Dive HTML 발행 (Executive Summary + Debate/Contrarian Card + 종목 영향 매트릭스)</li>
      <li><strong>종목 분석 시</strong> — stock-analyst-lead 가 종목 섹터 매핑 → 최근 L2 3건 + 최신 분기 L3 1건을 자동 발췌해 분석 5개 에이전트 + scorecard 에 주입</li>
      <li><strong>scorecard</strong> — Research KB Alignment 점수 ±1~3 적용 (Bull 강화 → +/ Bear 시그널 → -)</li>
    </ol>
  </section>

  <!-- 10섹터 카드 -->
  <section class="sectors">
    <h2>🗂 섹터별 현황 (10섹터)</h2>
    <div class="sec-grid">
      {sectors.map((s) => (
        <article class={`sec-card status-${s.status}`}>
          <header>
            <span class="sec-emoji">{s.emoji}</span>
            <h3>{s.label}</h3>
            <span class={`sec-status status-${s.status}`}>{s.status === 'active' ? '활성' : s.status === 'scaffolded' ? '대기' : s.status}</span>
          </header>
          <div class="sec-counts">
            <div class="sec-cnt"><span class="lbl">L1</span><span class="val">{s.l1_count}</span></div>
            <div class="sec-cnt"><span class="lbl">L2</span><span class="val">{s.l2_count}</span></div>
            <div class="sec-cnt"><span class="lbl">L3</span><span class="val">{s.l3_count}</span></div>
            <div class="sec-cnt sec-use"><span class="lbl">인용</span><span class="val">{s.usage_count}</span></div>
          </div>
          {s.thesis_summary && (
            <p class="sec-thesis">{s.thesis_summary}</p>
          )}
          <footer>
            <span class="muted">갱신 {s.last_updated ?? '—'}</span>
            {s.l3_latest_quarter && (
              <a href={l3Link(s.id, s.l3_latest_quarter)} class="sec-l3-link">📄 {s.l3_latest_quarter} L3</a>
            )}
          </footer>
        </article>
      ))}
    </div>
  </section>

  <!-- 섹터별 활용 막대 차트 -->
  <section class="usage-chart">
    <h2>📊 섹터별 인용 활용 분포</h2>
    {usageBars.every((u) => u.count === 0) ? (
      <p class="empty">아직 인용 데이터가 충분하지 않습니다. 종목 분석을 진행하면 자동으로 누적됩니다.</p>
    ) : (
      <div class="bars">
        {usageBars.map((u) => (
          <div class="bar-row">
            <div class="bar-label"><span>{u.emoji}</span> {u.label}</div>
            <div class="bar-track">
              <div class="bar-fill" style={`width: ${(u.count / maxUsage) * 100}%`}></div>
            </div>
            <div class="bar-value">{u.count}<span class="bar-pct"> ({u.pct}%)</span></div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- 최근 활용 사례 -->
  <section class="recent-cases">
    <h2>🔍 최근 활용 사례 (Top {usage.recent_cases.length})</h2>
    {usage.recent_cases.length === 0 ? (
      <p class="empty">아직 Research KB 인용이 적용된 종목 분석이 없습니다.</p>
    ) : (
      <div class="cases">
        {usage.recent_cases.map((c) => (
          <article class="case">
            <header>
              <div class="case-name">
                <strong>{c.name || c.ticker}</strong>
                <span class="case-ticker">{c.ticker}</span>
                {c.version && <span class="case-ver">{c.version}</span>}
              </div>
              <div class="case-meta">
                <span class="case-sector">{c.sector_label}</span>
                <span class="case-date">{c.analyzed_at}</span>
                <span class="case-count">{c.citations_count} 인용</span>
              </div>
            </header>
            <ul class="case-citations">
              {c.citations.map((cit) => <li>📄 {cit}</li>)}
            </ul>
          </article>
        ))}
      </div>
    )}
  </section>

</Base>

<style>
  /* KPI 행 */
  .kpi-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }
  @media (max-width: 768px) {
    .kpi-row { grid-template-columns: repeat(2, 1fr); }
  }
  .kpi {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.95rem 1.1rem;
  }
  .kpi-label { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .kpi-value { font-size: 1.75rem; font-weight: 700; margin-top: 0.25rem; font-variant-numeric: tabular-nums; line-height: 1.1; }
  .kpi-frac { font-size: 1.1rem; color: var(--muted); font-weight: 500; }
  .kpi-status { font-size: 1.1rem; }
  .kpi-status.status-early { color: var(--warn); }
  .kpi-status.status-active { color: var(--accent); }
  .kpi-status.status-stable { color: var(--up); }
  .kpi-sub { color: var(--muted); font-size: 0.75rem; margin-top: 0.35rem; }

  /* 설명 */
  .explain {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.2rem;
    margin-bottom: 1.5rem;
  }
  .explain h2 { font-size: 1rem; margin: 0 0 0.6rem; }
  .explain ol { margin: 0; padding-left: 1.3rem; font-size: 0.88rem; line-height: 1.7; color: var(--muted); }
  .explain ol strong { color: var(--text); }

  /* 섹터 카드 */
  .sectors { margin-bottom: 1.75rem; }
  .sectors h2 { font-size: 1.1rem; margin: 0 0 0.85rem; }
  .sec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 0.75rem;
  }
  .sec-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .sec-card.status-scaffolded { opacity: 0.6; border-style: dashed; }
  .sec-card header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .sec-emoji { font-size: 1.25rem; }
  .sec-card h3 { margin: 0; font-size: 0.95rem; flex: 1; }
  .sec-status {
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    font-weight: 600;
  }
  .sec-status.status-active { background: rgba(16,185,129,.15); color: var(--up); }
  .sec-status.status-scaffolded { background: rgba(245,158,11,.15); color: var(--warn); }
  .sec-counts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.4rem;
  }
  .sec-cnt {
    background: var(--surface-2);
    border-radius: 6px;
    padding: 0.35rem 0.4rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .sec-cnt .lbl { font-size: 0.65rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .sec-cnt .val { font-size: 1rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .sec-cnt.sec-use .val { color: var(--accent); }
  .sec-thesis {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.5;
    color: var(--muted);
    border-left: 2px solid var(--accent);
    padding-left: 0.6rem;
  }
  .sec-card footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    margin-top: auto;
  }
  .sec-l3-link {
    color: var(--accent);
    text-decoration: none;
    font-weight: 600;
  }
  .sec-l3-link:hover { text-decoration: underline; }
  .muted { color: var(--muted); }

  /* 사용 막대 */
  .usage-chart {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem 1.2rem;
    margin-bottom: 1.5rem;
  }
  .usage-chart h2 { font-size: 1rem; margin: 0 0 0.75rem; }
  .bars { display: flex; flex-direction: column; gap: 0.4rem; }
  .bar-row {
    display: grid;
    grid-template-columns: 140px 1fr 110px;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
  }
  .bar-label { display: flex; gap: 0.3rem; align-items: center; }
  .bar-track {
    height: 14px;
    background: var(--surface-2);
    border-radius: 7px;
    overflow: hidden;
  }
  .bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    border-radius: 7px;
  }
  .bar-value {
    font-variant-numeric: tabular-nums;
    color: var(--text);
    font-weight: 600;
    text-align: right;
  }
  .bar-pct { color: var(--muted); font-weight: 400; font-size: 0.78rem; }

  /* 사례 */
  .recent-cases h2 { font-size: 1.1rem; margin: 0 0 0.85rem; }
  .cases { display: flex; flex-direction: column; gap: 0.7rem; }
  .case {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.85rem 1rem;
  }
  .case header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .case-name strong { font-size: 1rem; }
  .case-ticker {
    margin-left: 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.75rem;
    color: var(--muted);
    background: var(--surface-2);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }
  .case-ver { margin-left: 0.3rem; font-size: 0.7rem; color: var(--accent); }
  .case-meta { display: flex; gap: 0.5rem; flex-wrap: wrap; font-size: 0.75rem; color: var(--muted); }
  .case-sector { background: var(--surface-2); padding: 0.1rem 0.45rem; border-radius: 999px; }
  .case-count { color: var(--accent); font-weight: 600; }
  .case-citations {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .case-citations li {
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.5;
    padding-left: 0.25rem;
  }

  .empty {
    color: var(--muted);
    font-size: 0.85rem;
    padding: 1rem;
    text-align: center;
    background: var(--surface-2);
    border-radius: 8px;
  }

  /* 모바일 */
  @media (max-width: 768px) {
    .bar-row { grid-template-columns: 100px 1fr 85px; font-size: 0.78rem; }
    .sec-counts { grid-template-columns: repeat(4, 1fr); }
  }
</style>
